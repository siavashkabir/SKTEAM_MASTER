"""
Voice-chat music player (runs on your VPS / Termux Ubuntu).
"""
import asyncio
import os
import time
import logging
from pathlib import Path

from dotenv import load_dotenv
load_dotenv()

import httpx
import yt_dlp
from pyrogram import Client
from pytgcalls import PyTgCalls, filters
from pytgcalls.types import MediaStream, AudioQuality, Update

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("player")

API_BASE = os.environ["PANEL_API_BASE"].rstrip("/")
PLAYER_KEY = os.environ["PLAYER_API_KEY"]
API_ID = int(os.environ["TG_API_ID"])
API_HASH = os.environ["TG_API_HASH"]
SESSION = os.environ.get("TG_SESSION_STRING")
POLL_SECONDS = float(os.environ.get("POLL_SECONDS", "2"))
CACHE = Path(os.environ.get("CACHE_DIR", "/data/cache"))
CACHE.mkdir(parents=True, exist_ok=True)

HEADERS = {"X-Api-Key": PLAYER_KEY}

EQ = {
    "normal": "",
    "bass": "bass=g=8",
    "pop": "bass=g=3,equalizer=f=1000:t=q:w=1:g=3,treble=g=3",
    "rock": "bass=g=5,equalizer=f=1000:t=q:w=1:g=-2,treble=g=4",
    "vocal": "bass=g=-3,equalizer=f=2500:t=q:w=1:g=5",
    "classical": "equalizer=f=250:t=q:w=1:g=2,treble=g=3",
}

app = Client("helper", api_id=API_ID, api_hash=API_HASH, session_string=SESSION, workdir="/data")
calls = PyTgCalls(app)
http = httpx.AsyncClient(timeout=120, headers=HEADERS)

state: dict[int, dict] = {}


def ydl_opts(out: str, mp3: bool):
    o = {
        "format": "bestaudio/best",
        "outtmpl": out,
        "quiet": True,
        "noplaylist": True,
        "default_search": "scsearch1",
        "extractor_args": {"youtube": {"player_client": ["android", "ios"]}},
    }
    if mp3:
        o["postprocessors"] = [
            {"key": "FFmpegExtractAudio", "preferredcodec": "mp3", "preferredquality": "320"},
            {"key": "FFmpegMetadata"},
        ]
    return o


def _yt_download(query: str, mp3: bool) -> tuple[str, dict]:
    import sys as _sys
    _sys.stderr.write(f"[DEBUG yt_download] query={query!r}\n")
    _sys.stderr.flush()
    # ★ YouTube → SoundCloud (چون YouTube بلاکه)
    if "youtube.com" in query or "youtu.be" in query:
        import re as _re
        # اگه URL خالص یوتیوب بود، از عنوان نمی‌تونیم استفاده کنیم
        # پس به جای search مستقیم، کل query رو یه hash می‌کنیم
        # بهتر: از API لاوابل بخوایم search کنه
        pass
    if "youtube.com" in query or "youtu.be" in query:
        try:
            import re as _re, urllib.request as _ur, json as _json
            _m = _re.search(r"(?:v=|youtu\.be/|/embed/|/shorts/)([A-Za-z0-9_-]{11})", query)
            if _m:
                _api = "https://www.youtube.com/oembed?url=https://www.youtube.com/watch?v=" + _m.group(1) + "&format=json"
                _req = _ur.Request(_api, headers={"User-Agent": "Mozilla/5.0"})
                with _ur.urlopen(_req, timeout=10) as _r:
                    _title = _json.loads(_r.read()).get("title", "")
                if _title:
                    print(f"[yt->sc] {_title}")
                    query = "scsearch1:" + _title
        except Exception as _e:
            print(f"oEmbed fail: {_e}")
    import sys as _sys
    _sys.stderr.write(f"[DEBUG-in] {query!r}\n")
    _sys.stderr.flush()
    # ★ همیشه به SoundCloud search تبدیل کن
    if "soundcloud.com" not in query and not query.startswith("scsearch"):
        query = "scsearch1:" + query
        _sys.stderr.write(f"[DEBUG-out] {query!r}\n")
        _sys.stderr.flush()
    key = str(abs(hash(query)))
    out = str(CACHE / f"{key}{'_mp3' if mp3 else ''}.%(ext)s")
    with yt_dlp.YoutubeDL(ydl_opts(out, mp3)) as ydl:
        info = ydl.extract_info(query, download=True)
        if "entries" in info:
            info = info["entries"][0]
        path = ydl.prepare_filename(info)
        if mp3:
            path = str(Path(path).with_suffix(".mp3"))
    return path, info


async def fetch_media(item: dict) -> str:
    if item.get("tg_file_id"):
        path = CACHE / f"tg_{item['tg_file_id'][-40:]}"
        if not path.exists():
            r = await http.get(f"{API_BASE}/player/file", params={"file_id": item["tg_file_id"]})
            r.raise_for_status()
            path.write_bytes(r.content)
        return str(path)
    path, _ = await asyncio.to_thread(_yt_download, item["source_url"], False)
    return path


def stream(path: str, eq: str, seek: float = 0) -> MediaStream:
    af = EQ.get(eq, "")
    ff = ""
    if seek > 1:
        ff += f"-ss {int(seek)} "
    if af:
        ff += f"-af {af}"
    return MediaStream(path, audio_parameters=AudioQuality.STUDIO, video_flags=MediaStream.Flags.IGNORE,
                       ffmpeg_parameters=ff.strip() or None)


async def play_next(chat_id: int, finished: str | None = None):
    r = await http.post(f"{API_BASE}/player/next", json={"chat_id": chat_id, "finished_item_id": finished})
    data = r.json()
    item = data.get("item")
    if not item:
        state.pop(chat_id, None)
        try:
            await calls.leave_call(chat_id)
        except Exception:
            pass
        return
    try:
        path = await fetch_media(item)
    except Exception as e:
        log.error("fetch failed: %s", e)
        return await play_next(chat_id, item["id"])
    eq = data.get("eq", "normal")
    await calls.play(chat_id, stream(path, eq))
    await set_volume(chat_id, int(data.get("volume", 100)))
    state[chat_id] = {"item": item, "path": path, "eq": eq, "started": time.time(), "paused_at": None, "offset": 0}


async def download_and_send(chat_id: int, p: dict):
    src = p.get("source_url")
    if not src:
        return
    path, info = await asyncio.to_thread(_yt_download, src, True)
    with open(path, "rb") as f:
        files = {"audio": (Path(path).name, f, "audio/mpeg")}
        data = {
            "chat_id": str(chat_id),
            "title": p.get("title") or info.get("title", ""),
            "performer": p.get("performer") or info.get("uploader", ""),
            "duration": str(int(info.get("duration") or 0)),
            "queue_item_id": p.get("queue_item_id") or "",
        }
        r = await http.post(f"{API_BASE}/player/upload", data=data, files=files)
        log.info("upload: %s", r.text[:200])


async def set_volume(chat_id: int, v: int):
    if v <= 0:
        await calls.mute(chat_id)
        return
    try:
        await calls.unmute(chat_id)
    except Exception:
        pass
    await calls.change_volume_call(chat_id, min(200, v))


def elapsed(s: dict) -> float:
    if s["paused_at"]:
        return s["paused_at"] - s["started"] + s["offset"]
    return time.time() - s["started"] + s["offset"]


async def handle(cmd: dict):
    chat_id = int(cmd["chat_id"])
    a = cmd["action"]
    p = cmd.get("payload") or {}
    s = state.get(chat_id)
    log.info("cmd %s %s", chat_id, a)
    if a == "play_next":
        if not s:
            await play_next(chat_id)
    elif a == "pause" and s:
        await calls.pause(chat_id)
        s["paused_at"] = time.time()
    elif a == "resume" and s:
        await calls.resume(chat_id)
        if s["paused_at"]:
            s["started"] += time.time() - s["paused_at"]
            s["paused_at"] = None
    elif a == "skip":
        await play_next(chat_id, s["item"]["id"] if s else None)
    elif a == "stop":
        state.pop(chat_id, None)
        try:
            await calls.leave_call(chat_id)
        except Exception:
            pass
    elif a == "volume" and s:
        await set_volume(chat_id, int(p.get("volume", 100)))
    elif a == "eq" and s:
        pos = elapsed(s)
        s["eq"] = p.get("eq", "normal")
        await calls.play(chat_id, stream(s["path"], s["eq"], pos))
        s.update(started=time.time(), offset=pos, paused_at=None)
    elif a == "download":
        asyncio.create_task(download_and_send(chat_id, p))


@calls.on_update(filters.stream_end())
async def on_end(_, update: Update):
    s = state.get(update.chat_id)
    await play_next(update.chat_id, s["item"]["id"] if s else None)


async def poll_loop():
    while True:
        try:
            r = await http.get(f"{API_BASE}/player/commands")
            if r.status_code == 200:
                for c in r.json().get("commands", []):
                    try:
                        await handle(c)
                    except Exception as e:
                        log.exception("command failed: %s", e)
            else:
                log.warning("poll %s %s", r.status_code, r.text[:200])
        except Exception as e:
            log.warning("poll error: %s", e)
        await asyncio.sleep(POLL_SECONDS)


async def main():
    await calls.start()
    me = await app.get_me()
    log.info("Helper account online: %s", me.username or me.id)
    await poll_loop()


if __name__ == "__main__":
    asyncio.get_event_loop().run_until_complete(main())
