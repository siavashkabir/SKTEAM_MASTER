"""پنل تنظیمات اصلی Sk.Team"""
from telegram import InlineKeyboardButton, InlineKeyboardMarkup
import settings as cfg

CB = {
    "skin":    "set:skin",
    "sub":     "set:sub",
    "player":  "set:player",
    "tools":   "set:tools",
    "stats":   "set:stats",
    "back":    "set:back",
    "close":   "set:close",
}

def _b(t, cb): return InlineKeyboardButton(t, callback_data=cb)



def record_menu(chat_id):
    """منوی رکورد ویس‌کال"""
    import sqlite3
    from pathlib import Path as _P
    _db = _P(__file__).parent / "data" / "settings.db"
    _clip = 300
    _enabled = 0
    try:
        _c = sqlite3.connect(str(_db))
        _c.execute("""CREATE TABLE IF NOT EXISTS record_settings (
            chat_id INTEGER PRIMARY KEY,
            enabled INTEGER DEFAULT 0,
            clip_sec INTEGER DEFAULT 300,
            updated_at INTEGER)""")
        _c.commit()
        _r = _c.execute("SELECT enabled, clip_sec FROM record_settings WHERE chat_id=?",
                        (chat_id,)).fetchone()
        if _r:
            _enabled, _clip = _r[0], _r[1]
        _c.close()
    except Exception:
        pass

    clip_label = {
        60: "۱ دقیقه", 180: "۳ دقیقه", 300: "۵ دقیقه",
        600: "۱۰ دقیقه", 900: "۱۵ دقیقه",
        1800: "۳۰ دقیقه", 3600: "۱ ساعت",
    }.get(_clip, f"{_clip} ثانیه")

    status_icon = "✅" if _enabled else "❌"
    status_txt = "فعال" if _enabled else "خاموش"

    text = (
        f"🎙 **ضبط ویس‌کال**\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"{status_icon} وضعیت: {status_txt}\n"
        f"⏱ طول هر کلیپ: {clip_label}\n"
        f"📤 ارسال به: PV مالک گروه\n\n"
        f"⚠️ وقتی موزیک پخش می‌شه، ضبط خودکار pause می‌شه\n"
        f"و بعد پایان موزیک دوباره active می‌شه."
    )
    kb = [
        [_b(f"{status_icon} {'خاموش کردن' if _enabled else 'فعال کردن'}",
            "set:rec_toggle")],
        [_b(f"⏱ تغییر طول کلیپ ({clip_label})", "set:rec_clip")],
        [_b("🔙 بازگشت", CB["back"]),
         _b("❌ بستن", CB["close"])],
    ]
    return text, InlineKeyboardMarkup(kb)



def record_clip_menu(chat_id):
    """انتخاب طول کلیپ با تیک روی فعلی"""
    import sqlite3
    from pathlib import Path as _P
    _db = _P(__file__).parent / "data" / "settings.db"
    _clip = 300
    try:
        _c = sqlite3.connect(str(_db))
        _r = _c.execute("SELECT clip_sec FROM record_settings WHERE chat_id=?",
                        (chat_id,)).fetchone()
        if _r:
            _clip = _r[0]
        _c.close()
    except Exception:
        pass

    clips = [
        (60, "۱ دقیقه"), (180, "۳ دقیقه"), (300, "۵ دقیقه"),
        (600, "۱۰ دقیقه"), (900, "۱۵ دقیقه"),
        (1800, "۳۰ دقیقه"), (3600, "۱ ساعت"),
    ]
    rows = []
    for i in range(0, len(clips), 2):
        row = []
        for j in range(2):
            if i + j < len(clips):
                sec, lbl = clips[i + j]
                mark = "✅ " if sec == _clip else ""
                row.append(_b(f"{mark}⏱ {lbl}", f"set:rec_clip_set:{sec}"))
        rows.append(row)
    rows.append([_b("🔙 بازگشت", "set:rec")])

    current = next((lbl for sec, lbl in clips if sec == _clip), f"{_clip}s")
    return (
        f"⏱ **طول هر کلیپ ضبط**\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"✅ فعلی: {current}\n\n"
        f"انتخاب کن هر چند وقت یه بار برات فایل بفرستم:",
        InlineKeyboardMarkup(rows),
    )

def main_menu(chat_id, chat_title, user_name, is_owner):
    """پنل تنظیمات اصلی"""
    s = cfg.get(chat_id)
    role = "👑 سازنده" if is_owner else "⭐ سودو"

    # اشتراک (placeholder - بعداً به groupbot.db وصل می‌شه)
    sub_status = "✅ فعال"
    sub_days = "—"
    try:
        import sub_check
        info = sub_check.get_subscription(chat_id)
        sub_status = "✅ فعال" if info.get("active") else "❌ غیرفعال"
        sub_days = info.get("days_left", "—")
    except Exception:
        pass

    text = (
        f"⚙️ پنل تنظیمات Sk.Team\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"📍 گروه: {chat_title}\n"
        f"👤 شما: {user_name} ({role})\n"
        f"\n"
        f"┌─ وضعیت اشتراک ─────┐\n"
        f"│ 🎵 موزیک‌پلیر      │\n"
        f"│ {sub_status:<8}          │\n"
        f"│ 📅 باقی‌مانده: {sub_days}\n"
        f"└────────────────────┘\n"
        f"\n"
        f"🎨 اسکین فعلی: {s['skin']}"
    )
    kb = [
        [_b("🎨 اسکین پنل", CB["skin"]),
         _b("💎 اشتراک", CB["sub"])],
        [_b("🎛 تنظیمات پلیر", CB["player"]),
         _b("🎞 گیف‌ها", "set:gifs")],
        [_b("🔧 ابزارها", CB["tools"])],
        [_b("📊 آمار", CB["stats"])],
        [_b("❌ بستن", CB["close"])],
    ]
    return text, InlineKeyboardMarkup(kb)

