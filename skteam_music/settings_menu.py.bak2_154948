# ─── GIF Menu ───
def gifs_menu(chat_id):
    import gifs
    s = cfg.get(chat_id)
    items = gifs.list_all(chat_id)
    n = len(items)
    active = gifs.active(chat_id)
    active_name = active["name"] if active else "—"

    text = (
        f"🎞 گیف‌های پلیر\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"📊 وضعیت: {'✅ فعال' if s['gif_enabled'] else '❌ غیرفعال'}\n"
        f"📁 تعداد: {n}\n"
        f"⭐ فعال: {active_name}\n"
    )
    if n == 0:
        text += "\n⚠️ هنوز گیفی اضافه نشده.\n"

    rows = []
    rows.append([
        _b(f"🎞 {'خاموش کن' if s['gif_enabled'] else 'روشن کن'}", "set:gif_toggle"),
    ])
    rows.append([_b("➕ افزودن گیف جدید", "set:gif_add")])
    for it in items[:10]:
        star = "⭐" if it["is_active"] else "⚪"
        nm = it["name"][:15]
        rows.append([
            _b(f"{star} {nm}", f"set:gif_act:{it['id']}"),
            _b("🗑", f"set:gif_del:{it['id']}"),
        ])
    rows.append([_b("🔙 بازگشت", CB["back"]), _b("❌ بستن", CB["close"])])
    return text, InlineKeyboardMarkup(rows)


def edit_message_menu():
    """منوی ویرایش پیام‌های ربات (فقط سازنده)"""
    import settings as cfg_m
    all_cfg = cfg_m.get_all_cfg()

    def short(s, n=40):
        s = (s or "").replace("\n", " ")
        return s[:n] + ("..." if len(s) > n else "")

    text = (
        f"✏️ **ویرایش پیام‌های ربات**\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"اینجا می‌تونی پیام‌های ربات رو ویرایش کنی:"
    )
    kb = [
        [_b(f"📝 عنوان: {short(all_cfg['welcome_title'], 25)}", "editmsg:title")],
        [_b("📄 متن معرفی", "editmsg:intro")],
        [_b("📞 خط تماس", "editmsg:contact")],
        [_b("📢 کانال (متن)", "editmsg:channel")],
        [_b("🔗 لینک کانال", "editmsg:channel_url")],
        [_b("🌐 وب‌سایت (متن)", "editmsg:website")],
        [_b("🔗 لینک وب‌سایت", "editmsg:website_url")],
        [_b("👤 لینک تماس", "editmsg:creator_url")],
        [_b("👁 پیش‌نمایش", "editmsg:preview")],
        [_b("🔄 بازگشت به پیش‌فرض", "editmsg:reset")],
        [_b("❌ بستن", CB["close"])],
    ]
    return text, InlineKeyboardMarkup(kb)


def edit_msg_field_menu(field):
    """منوی ویرایش یه فیلد خاص"""
    import settings as cfg_m
    all_cfg = cfg_m.get_all_cfg()
    labels = {
        "title": "📝 عنوان",
        "intro": "📄 متن معرفی",
        "contact": "📞 خط تماس",
        "channel": "📢 متن کانال",
        "channel_url": "🔗 لینک کانال",
        "website": "🌐 متن وب‌سایت",
        "website_url": "🔗 لینک وب‌سایت",
        "creator_url": "👤 لینک تماس سازنده",
    }
    current = all_cfg.get(field, "")
    preview = current[:300] + ("..." if len(current) > 300 else "")
    text = (
        f"✏️ **ویرایش: {labels.get(field, field)}**\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"📌 مقدار فعلی:\n"
        f"`{preview}`\n\n"
        f"مقدار جدید رو بفرست (Reply این پیام):"
    )
    kb = [
        [_b("🗑 پاک کردن", f"editmsg_clear:{field}")],
        [_b("🔄 بازگشت به پیش‌فرض", f"editmsg_resetfield:{field}")],
        [_b("🔙 بازگشت", "editmsg_open")],
    ]
    return text, InlineKeyboardMarkup(kb)


def edit_msg_preview():
    """پیش‌نمایش پیام نهایی"""
    import settings as cfg_m
    cfg = cfg_m.get_all_cfg()
    text = (
        f"👁 **پیش‌نمایش پیام /start**\n"
        f"━━━━━━━━━━━━━━━━━\n\n"
        f"{cfg['welcome_title']}\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"سلام [نام کاربر] 👋\n\n"
        f"{cfg['welcome_intro']}\n\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"{cfg['footer_contact']}"
    )
    if cfg.get('footer_channel'):
        text += f"\n{cfg['footer_channel']}"
    if cfg.get('footer_website'):
        text += f"\n{cfg['footer_website']}"
    kb = [
        [_b("🔙 بازگشت", "editmsg_open")],
    ]
    return text, InlineKeyboardMarkup(kb)
