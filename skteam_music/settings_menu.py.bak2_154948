def skins_menu(chat_id, preview=None):
    """منوی اسکین با پیش‌نمایش + دکمه‌ها"""
    s = cfg.get(chat_id)
    import panels
    current = s["skin"]

    # ─── اگه preview ───
    if preview and preview in panels.SKINS:
        demo = {
            "playing": True, "paused": False, "muted": False,
            "title": "Googoosh - Noghteye Payan",
            "position": 45, "duration": 240,
            "volume": 100, "speed": 1.0,
            "source": "SoundCloud", "requested_by_name": "Siavash",
            "eq": "Off", "repeat": "off", "shuffle": False,
        }
        try:
            prev_text, prev_kb = panels.render(preview, demo)
        except Exception as e:
            prev_text = f"❌ خطا: {e}"
            prev_kb = None

        text = (
            f"🎨 پیش‌نمایش اسکین\n"
            f"━━━━━━━━━━━━━━━━━\n"
            f"🎯 {panels.SKIN_LABELS.get(preview, preview)}\n"
            f"⚠️ (آهنگ نمونه — دکمه‌ها تستی)\n"
            f"\n{prev_text}"
        )
        # ★ ترکیب دکمه‌های پیش‌نمایش + کنترل‌های منو
        rows = []
        if prev_kb and prev_kb.inline_keyboard:
            # فقط ۲ ردیف اول از پیش‌نمایش
            for row in prev_kb.inline_keyboard[:3]:
                rows.append(row)
        # دکمه‌های منو
        rows.append([
            _b("✅ تایید و اعمال", f"set:skin_apply:{preview}"),
        ])
        rows.append([
            _b("🔙 برگشت به لیست", "set:skin"),
            _b("❌ بستن", CB["close"]),
        ])
        return text, InlineKeyboardMarkup(rows)

    # ─── منوی اصلی ───
    rows = []
    # ★ اسکین‌ها توی ردیف‌های ۲ تایی
    items = list(panels.SKINS)
    for i in range(0, len(items), 2):
        row = []
        for j in range(2):
            if i + j < len(items):
                sk = items[i + j]
                mark = "✅ " if sk == current else ""
                row.append(_b(f"{mark}{panels.SKIN_LABELS.get(sk, sk)}",
                              f"set:skin_prev:{sk}"))
        rows.append(row)
    rows.append([_b("🔙 بازگشت", CB["back"]), _b("❌ بستن", CB["close"])])
    text = (
        f"🎨 انتخاب اسکین پنل\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"🎯 فعلی: {panels.SKIN_LABELS.get(current, current)}\n"
        f"📊 {len(items)} اسکین موجود\n\n"
        f"برای پیش‌نمایش، روی هر اسکین بزن."
    )
    return text, InlineKeyboardMarkup(rows)

