# ─── اتصال مستقیم به اشتراک‌های groupbot ───
_GB_DB = Path.home() / "groupbot" / "data" / "groupbot.db"

def _sub_is_active(chat_id, sub_type):
    """چک اشتراک از groupbot.db (مسیر مطلق)"""
    import sqlite3 as _s
    from datetime import datetime as _dt
    if not _GB_DB.exists():
        log.warning(f"[sub] DB نیست: {_GB_DB}")
        return False
    try:
        conn = _s.connect(str(_GB_DB), timeout=5)
        r = conn.execute(
            "SELECT expire_date, enabled FROM subscriptions WHERE chat_id=? AND sub_type=?",
            (chat_id, sub_type)
        ).fetchone()
        conn.close()
        if not r:
            return False
        exp_str, enabled = r
        if not enabled:
            return False
        try:
            exp = _dt.strptime(exp_str.split()[0], "%Y-%m-%d")
            return exp > _dt.now()
        except Exception:
            return False
    except Exception as e:
        log.warning(f"[sub] err: {e}")
        return False


def _sub_days(chat_id, sub_type):
    """روزهای مانده"""
    import sqlite3 as _s
    from datetime import datetime as _dt
    if not _GB_DB.exists():
        return 0
    try:
        conn = _s.connect(str(_GB_DB), timeout=5)
        r = conn.execute(
            "SELECT expire_date, enabled FROM subscriptions WHERE chat_id=? AND sub_type=?",
            (chat_id, sub_type)
        ).fetchone()
        conn.close()
        if not r or not r[1]:
            return 0
        try:
            exp = _dt.strptime(r[0].split()[0], "%Y-%m-%d")
            delta = (exp - _dt.now()).days
            return max(0, delta)
        except Exception:
            return 0
    except Exception:
        return 0


