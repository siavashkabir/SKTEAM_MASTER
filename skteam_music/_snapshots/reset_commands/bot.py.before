# ─── auto-delete (with panel timer reset) ───
_panel_timers = {}

async def _auto_delete_task(key, sec, msg):
    try:
        await asyncio.sleep(sec)
        try:
            await msg.delete()
        except Exception:
            pass
    except asyncio.CancelledError:
        pass
    finally:
        info = _panel_timers.get(key)
        if info and info.get('task') is asyncio.current_task():
            _panel_timers.pop(key, None)

def schedule_delete(context, msg, sec=40):
    if msg is None:
        return
    key = (msg.chat.id, msg.message_id)
    old = _panel_timers.get(key)
    if old:
        try: old['task'].cancel()
        except Exception: pass
    task = context.application.create_task(_auto_delete_task(key, sec, msg))
    _panel_timers[key] = {'task': task, 'sec': sec, 'msg': msg}

def reset_panel_timer(chat_id, message_id):
    key = (chat_id, message_id)
    info = _panel_timers.get(key)
    if not info:
        return
    sec = info.get('sec', 60)
    msg = info.get('msg')
    if not msg:
        return
    old_task = info.get('task')
    if old_task:
        try: old_task.cancel()
        except Exception: pass
    try:
        loop = asyncio.get_event_loop()
        new_task = loop.create_task(_auto_delete_task(key, sec, msg))
        info['task'] = new_task
    except Exception:
        pass

# ─── auth ───
async def is_owner_or_sudo(uid):
    return db.is_owner(uid) or db.is_sudo(uid)

async def can_play(uid, cid):
    if db.is_owner(uid) or db.is_sudo(uid): return True
    return db.is_music_authorized(cid, uid)

# ─── server helpers ───
async def send_speed(cid, delta=None, reset=False):
    """تغییر سرعت پخش"""
    if reset:
        return await post_cmd({"action": "speed", "chat_id": cid, "value": 1.0})
    return await post_cmd({
        "action": "speed_delta",
        "chat_id": cid,
        "delta": delta,
    })


async def send_seek(cid, direction, secs):
    """ارسال دستور seek"""
    return await post_cmd({
        "action": "seek",
        "chat_id": cid,
        "direction": direction,
        "seconds": secs,
    })


async def add_to_queue(cid, query, uid, uname):
    """افزودن آهنگ به صف سرور"""
    try:
        async with httpx.AsyncClient(timeout=10) as h:
            r = await h.post(f"{SK_SERVER}/queue/add", json={
                "chat_id": cid,
                "query": query,
                "requested_by": uid,
                "requested_by_name": uname or "",
            })
            d = r.json()
            return d.get("size", 0)
    except Exception as e:
        log.warning(f"queue add err: {e}")
        return 0


async def post_cmd(payload):
    try:
        async with httpx.AsyncClient(timeout=10) as h:
            r = await h.post(f"{SK_SERVER}/command", json=payload)
            return r.json()
    except Exception as e:
        return {"ok": False, "error": str(e)}

async def get_srv(path, params=None):
    try:
        async with httpx.AsyncClient(timeout=5) as h:
            r = await h.get(f"{SK_SERVER}{path}", params=params or {})
            return r.json()
    except Exception as e:
        return {"ok": False, "error": str(e)}

# ─── parsers ───
# کلمات کنترل — اینا رو play نگیر
CONTROL_WORDS = {
    "بعدی", "قبلی", "توقف", "مکث", "ادامه", "بس کن", "استاپ",
    "next", "prev", "previous", "skip", "stop", "pause", "resume", "continue",
    "بی‌صدا", "باصدا", "mute", "unmute",
    "صف", "queue", "پنل", "پلیر", "np",
    "ریپیت", "repeat", "shuffle", "شافل",
    "پینگ", "ping", "ریست", "reset",
}

def _is_control(q):
    q2 = q.strip().lower()
    return q2 in {w.lower() for w in CONTROL_WORDS}

PLAY_PATTERNS = [
    re.compile(r"^(?:پخش|بزن|پلی)\s+(.+)$"),
    re.compile(r"^(.+?)\s+را\s+(?:پخش|بزن|پلی)(?:\s+کن)?$"),
]
def parse_play(text):
    for p in PLAY_PATTERNS:
        m = p.match(text)
        if m:
            q = m.group(1).strip()
            if _is_control(q):
                return None  # کلمه کنترل، play نیست
            return q
    return None
VOL_RE = re.compile(r"^(?:(?:تنظیم|کن|بکن)\s+)?(?:ولوم|صدا|volume)\s+(\d+)$")

# ─── panel ───
async def _panel_data(chat_id):
    """now-playing + settings → dict برای panels.render"""
    s = settings.get(chat_id)
    r = await get_srv("/now-playing", {"chat_id": chat_id})
    if not r.get("playing"):
        return {
            "playing": False, "paused": False, "muted": False,
            "title": "—", "position": 0, "duration": 0,
            "volume": 100, "source": "—", "requested_by": "—",
            "eq": "Off", "repeat": "off",
        }, s
    return {
        "playing": True,
        "paused": r.get("paused", False),
        "muted": r.get("muted", False),
        "title": r.get("title", "—"),
        "position": r.get("position", 0),
        "duration": r.get("duration", 0),
        "volume": r.get("volume", 100),
        "speed": r.get("speed", 1.0),
        "source": r.get("source", "soundcloud"),
        "requested_by": r.get("requested_by_name", "—"),
        "requested_by_name": r.get("requested_by_name", "—"),
        "eq": r.get("eq", "Off"),
        "repeat": r.get("repeat", "off"),
        "shuffle": r.get("shuffle", False),
    }, s

async def open_panel(update, context, from_cb=False):
    chat = update.effective_chat
    chat_id = chat.id
    s = settings.get(chat_id)
    data, _ = await _panel_data(chat_id)
    text, kb = panels.render(s["skin"], data)
    if from_cb:
        try:
            await update.callback_query.edit_message_text(text, reply_markup=kb)
        except Exception as e:
            log.warning(f"edit failed: {e}")
    else:
        m = await update.effective_message.reply_text(text, reply_markup=kb)
        # توی گروه بعد ۴۰ ثانیه پاک نکن (پنل باید بمونه)
        return m

# ─── commands ───


async def send_panel_with_gif(bot, cid, text, kb, gif_file_id, delete_old_msg_id=None):
    """ارسال پنل با GIF بالا"""
    if delete_old_msg_id:
        try: await bot.delete_message(cid, delete_old_msg_id)
        except: pass
    try:
        m = await bot.send_animation(
            chat_id=cid, animation=gif_file_id,
            caption=text, reply_markup=kb,
        )
        return m
    except Exception as e:
        log.warning(f"send_animation err: {e}")
        m = await bot.send_message(cid, text, reply_markup=kb)
        return m


async def edit_panel_gif(bot, cid, msg_id, text, kb, gif_file_id):
    """ادیت پنل موجود با GIF - بدون flicker"""
    # ★ تلگرام caption برای animation رو محدود به 1024 char می‌کنه
    if len(text) > 1000:
        text = text[:997] + "..."
    # ★ اول caption رو edit کن
    try:
        await bot.edit_message_caption(
            chat_id=cid, message_id=msg_id,
            caption=text, reply_markup=kb,
        )
        return True
    except Exception as e:
        err = str(e).lower()
        if "not modified" in err:
            return True
        # اگه caption edit نشد، فقط buttons رو edit کن
        try:
            await bot.edit_message_reply_markup(
                chat_id=cid, message_id=msg_id,
                reply_markup=kb,
            )
            return True
        except Exception as e2:
            if "not modified" not in str(e2).lower():
                log.debug(f"edit gif panel: {e2}")
            return False


async def open_live_panel(bot, chat_id, owner_uid, skin=None, force_new=False):
    """باز کردن/ادیت پنل زنده"""
    if skin is None:
        skin = settings.get(chat_id)["skin"]
    data, _ = await _panel_data(chat_id)
    text, kb = panels.render(skin, data)

    # ─── اگه پنل قبلی هست، فقط ادیت کن (نگه دار) ───
    if chat_id in active_panels and not force_new:
        old = active_panels[chat_id]
        try:
            await bot.edit_message_text(
                text=text, chat_id=chat_id,
                message_id=old["msg_id"], reply_markup=kb
            )
            # آپدیت owner/uid/skin
            old["owner_uid"] = owner_uid
            old["skin"] = skin
            return old
        except Exception as e:
            # اگه edit نشد (پیام حذف شده)، پنل جدید بساز
            log.debug(f"edit fail, creating new: {e}")
            active_panels.pop(chat_id, None)

    # ─── چک GIF فعال ───
    gif_id = None
    try:
        import gifs as _gm
        s_cfg = settings.get(chat_id)
        if s_cfg.get("gif_enabled"):
            gif = _gm.active(chat_id)
            if gif:
                gif_id = gif["file_id"]
    except Exception as e:
        log.debug(f"gif check: {e}")

    # ─── پنل جدید بساز ───
    if gif_id:
        # با GIF
        m = await send_panel_with_gif(bot, chat_id, text, kb, gif_id)
        active_panels[chat_id] = {
            "msg_id": m.message_id,
            "owner_uid": owner_uid,
            "skin": skin,
            "ever_played": False,
            "has_gif": True,
            "gif_id": gif_id,
        }
        log.warning(f'[PANEL] ADD {chat_id} msg={m.message_id}')
    else:
        # بدون GIF
        m = await bot.send_message(chat_id, text, reply_markup=kb)
        active_panels[chat_id] = {
            "msg_id": m.message_id,
            "owner_uid": owner_uid,
            "skin": skin,
            "ever_played": False,
            "has_gif": False,
        }
        log.warning(f'[PANEL] ADD {chat_id} msg={m.message_id}')
    return m


async def close_live_panel(bot, chat_id):
    """بستن پنل زنده"""
    if chat_id not in active_panels:
        return
    log.warning(f"[CLOSE] {chat_id}")
    info = active_panels.pop(chat_id)
    try:
        await bot.delete_message(chat_id, info["msg_id"])
    except Exception:
        pass


async def panel_updater_loop(app):
    """Job - هر ۳ ثانیه پنل‌ها رو update کن"""
    log.info("panel_updater_loop started")
    GRACE = 10  # ۱۰ بار = ۳۰ ثانیه صبر قبل بستن
    while True:
        await asyncio.sleep(3)
        # ★ TICK LOG
        tick = locals().get('tick', 0) + 1
        if tick % 10 == 0:
            log.warning(f'[LOOP] tick #{tick} active={len(active_panels)} locks={len(submenu_locks)}')
        # ★ چک pending records
        try:
            import httpx as _hr
            import os as _or
            async with _hr.AsyncClient(timeout=5) as _chr:
                _rr = await _chr.get(f"{SK_SERVER}/pending_records")
                _dr = _rr.json()
                for _fr in _dr.get("files", []):
                    _path = _fr.get("path", "")
                    # مسیر مشترک با Termux
                    if _or.path.exists(_path):
                        _clip = _fr.get("clip_sec", 0)
                        _ts = _fr.get("ts", 0)
                        from datetime import datetime as _dt
                        _dt_str = _dt.fromtimestamp(_ts).strftime("%Y/%m/%d - %H:%M:%S")
                        _clip_txt = f"{_clip//60} دقیقه" if _clip >= 60 else f"{_clip} ثانیه"
                        try:
                            with open(_path, "rb") as _fp:
                                await app.bot.send_audio(
                                    chat_id=OWNER_ID_REC,
                                    audio=_fp,
                                    title=f"🎙 ضبط {_dt_str}",
                                    performer="Sk.Team Recorder",
                                    caption=(
                                        f"🎙 **ضبط ویس‌کال**\n"
                                        f"━━━━━━━━━━━━━━\n"
                                        f"📅 {_dt_str}\n"
                                        f"⏱ طول: {_clip_txt}\n"
                                        f"🎵 Sk.Team Recorder"
                                    ),
                                    parse_mode="Markdown",
                                )
                            _or.remove(_path)
                            log.info(f"[rec] sent to owner: {_or.path.basename(_path)}")
                        except Exception as _er:
                            log.warning(f"[rec] send err: {_er}")
        except Exception as _er:
            log.debug(f"pending_records err: {_er}")

        # ★ چک download files
        try:
            import httpx as _hx
            import os as _os
            async with _hx.AsyncClient(timeout=5) as _ch:
                _r = await _ch.get(f"{SK_SERVER}/pending_files")
                _d = _r.json()
                for _f in _d.get("files", []):
                    _tnx = _f.get("path", "")
                    log.info(f"[dl_file] check: {_tnx}")
                    if _os.path.exists(_tnx):
                        try:
                            with open(_tnx, "rb") as _fp:
                                await app.bot.send_audio(
                                    chat_id=_f["chat_id"],
                                    audio=_fp,
                                    title=_f.get("title", "Sk.Team"),
                                    performer="Sk.Team",
                                    caption=f"📥 {_f.get('title','')}\n🎵 Sk.Team Music Player\n🎚 {_f.get('quality',128)}K",
                                )
                            _os.remove(_tnx)
                            log.info(f"[dl_file] sent: {_f.get('title')}")
                        except Exception as _e:
                            log.warning(f"[dl_file] send err: {_e}")
        except Exception as _e:
            log.debug(f"pending err: {_e}")

        if not active_panels:
            continue
        for chat_id in list(active_panels.keys()):
            info = active_panels.get(chat_id)
            if not info:
                continue
            # ★ اگه کاربر توی زیرمنو → skip refresh (max 5min)
            import time as _t
            _lk = submenu_locks.get(chat_id)
            if _lk and (_t.time() - _lk) < 300:
                log.warning(f"[LOOP] skip {chat_id} (lock {int(_t.time() - _lk)}s)")
                continue
            elif _lk:
                log.warning(f"[LOOP] lock expired {chat_id}")
                submenu_locks.pop(chat_id, None)
            log.warning(f"[LOOP] refresh {chat_id}")
            try:
                data, _ = await _panel_data(chat_id)
                playing = bool(data.get("playing"))
                info["ever_played"] = info.get("ever_played", False)

                if not playing:
                    # ★ اگه ever_played=True → سریع ببند (6s)
                    not_playing_counter[chat_id] = not_playing_counter.get(chat_id, 0) + 1
                    if not_playing_counter[chat_id] >= 2 and info.get("ever_played"):
                        log.info(f"panel auto-close: {chat_id}")
                        try:
                            await app.bot.send_message(chat_id, "⏹ پخش تموم شد")
                        except: pass
                        await close_live_panel(app.bot, chat_id)
                        not_playing_counter.pop(chat_id, None)
                        continue
                    # ★ اگه ever_played نیست → 30s صبر
                    if not_playing_counter[chat_id] >= 10:
                        await close_live_panel(app.bot, chat_id)
                        not_playing_counter.pop(chat_id, None)
                    continue
                    # اگه قبلاً پخش شده بود، حالا استاپ شده → سریع ببند (۱۵ ثانیه)
                    not_playing_counter[chat_id] = not_playing_counter.get(chat_id, 0) + 1
                    if not_playing_counter[chat_id] >= 5:
                        log.info(f"panel close (played then stopped): {chat_id}")
                        await close_live_panel(app.bot, chat_id)
                        not_playing_counter.pop(chat_id, None)
                    continue

                # ─── پخش فعاله ───
                info["ever_played"] = True
                not_playing_counter[chat_id] = 0
                # آپدیت پنل
                text, kb = panels.render(info["skin"], data)
                if info.get("has_gif") and info.get("gif_id"):
                    # با GIF (بدون flicker)
                    await edit_panel_gif(
                        app.bot, chat_id, info["msg_id"],
                        text, kb, info["gif_id"]
                    )
                else:
                    try:
                        await app.bot.edit_message_text(
                            text=text, chat_id=chat_id,
                            message_id=info["msg_id"], reply_markup=kb
                        )
                    except Exception as e:
                        if "not modified" not in str(e).lower():
                            log.debug(f"edit skip: {e}")
            except Exception as e:
                log.warning(f"panel loop err: {e}")


async def post_init(app):
    """راه‌اندازی job پس از start"""
    app.create_task(panel_updater_loop(app))

async def cmd_pv_panel(update, context):
    """پنل PV — سازنده: همه گروه‌ها | مالک: گروه‌های خودش | بقیه: پیام اشتراک"""
    if update.effective_chat.type != "private":
        return
    u = update.effective_user
    uid = u.id
    is_bot_owner = db.is_owner(uid)

    import sqlite3 as _s
    _db = Path.home() / "groupbot" / "data" / "groupbot.db"
    if not _db.exists():
        await update.message.reply_text("❌ دیتابیس نیست")
        return

    _c = _s.connect(str(_db))
    if is_bot_owner:
        # ★ سازنده → همه گروه‌ها
        rows = _c.execute("""SELECT chat_id, title FROM groups
                             ORDER BY title""").fetchall()
    else:
        # ★ مالک گروه → فقط گروه‌های خودش
        try:
            rows = _c.execute("""SELECT g.chat_id, g.title FROM groups g
                                 INNER JOIN group_owners go ON g.chat_id = go.chat_id
                                 WHERE go.user_id=?
                                 ORDER BY g.title""", (uid,)).fetchall()
        except Exception:
            rows = []
    _c.close()

    # ─── اگه هیچ گروهی نیست → پیام اشتراک ───
    if not rows:
        await update.message.reply_text(
            "❌ **اشتراک فعال ندارید**\n"
            "━━━━━━━━━━━━━━━━━\n"
            "شما در حال حاضر مالک هیچ گروهی با اشتراک فعال نیستید.\n\n"
            "🎵 اشتراک موزیک‌پلیر\n"
            "🎙 اشتراک رکورد ویس‌کال\n\n"
            "📞 برای خرید با @Siavashska تماس بگیرید",
            parse_mode="Markdown",
        )
        return

    # ─── نمایش هر گروه ───
    await update.message.reply_text(
        f"👋 سلام **{u.first_name}**\n"
        f"{'👑 سازنده ربات' if is_bot_owner else '🏢 مالک گروه'}\n"
        f"📊 {len(rows)} گروه پیدا شد"
    )

    for cid, title in rows:
        music_info = await get_music_sub_info(cid)
        record_info = await get_record_sub_info(cid)
        has_music = music_info["active"]
        has_record = record_info["active"]
        m_days = music_info["days"]
        r_days = record_info["days"]

        # وضعیت ضبط
        _clip_sec = 300; _en = 0
        try:
            _db2 = Path(__file__).parent / "data" / "settings.db"
            _c2 = _s.connect(str(_db2))
            _r = _c2.execute("SELECT enabled, clip_sec FROM record_settings WHERE chat_id=?",
                             (cid,)).fetchone()
            if _r: _en, _clip_sec = _r[0], _r[1]
            _c2.close()
        except: pass
        _clip_lbl = {60:"۱د",180:"۳د",300:"۵د",600:"۱۰د",900:"۱۵د",1800:"۳۰د",3600:"۱س"}.get(_clip_sec, f"{_clip_sec}s")

        m_txt = f"🎵 موزیک: {'✅ فعال (' + str(m_days) + ' روز)' if has_music else '❌ غیرفعال'}"
        r_txt = f"🎙 رکورد: {'✅ فعال (' + str(r_days) + ' روز)' if has_record else '❌ غیرفعال'}"
        text = (
            f"📁 **{title}**\n"
            f"🆔 `{cid}`\n"
            f"━━━━━━━━━━━━━━━\n"
            f"{m_txt}\n"
            f"{r_txt}"
        )
        if has_record:
            text += f"\n🎬 وضعیت ضبط: {'🔴 در حال ضبط' if _en else '⏹ خاموش'} | طول: {_clip_lbl}"

        kb_rows = []
        # فقط اگه اشتراک رکورد داره
        if has_record:
            kb_rows.append([
                InlineKeyboardButton(
                    f"{'⏹ خاموش کردن' if _en else '🔴 شروع ضبط'}",
                    callback_data=f"pvrec_toggle:{cid}"
                ),
            ])
            kb_rows.append([
                InlineKeyboardButton(f"⏱ طول کلیپ: {_clip_lbl}",
                                     callback_data=f"pvrec_clip:{cid}"),
            ])
        # ─── سازنده: دکمه تعیین اشتراک ───
        if is_bot_owner:
            kb_rows.append([
                InlineKeyboardButton("💎 تعیین اشتراک",
                                     callback_data=f"pvsub_set:{cid}"),
            ])
        kb_rows.append([
            InlineKeyboardButton("❌ بستن", callback_data="pvrec_close"),
        ])
        await update.message.reply_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(kb_rows),
        )


async def cmd_start(update, context):
    """start هوشمند — توضیحات + اشتراک + پنل گروه‌ها"""
    u = update.effective_user
    # ─── اگه توی گروه ───
    if update.effective_chat.type != "private":
        await update.message.reply_text(
            f"🎵 **Sk.Team Music Player**\n"
            f"━━━━━━━━━━━━━━━\n"
            f"سلام {u.first_name} 👋\n\n"
            f"منو به گروهت اضافه کن و بنویس:\n"
            f"«پخش X» تا آهنگ پخش شه 🎧\n\n"
            f"📞 پشتیبانی: @Siavashska",
            parse_mode="Markdown",
        )
        return

    # ─── توی PV ───
    uid = u.id
    is_bot_owner = db.is_owner(uid)

    # ─── چک اشتراک کاربر ───
    import sqlite3 as _s
    _db = Path.home() / "groupbot" / "data" / "groupbot.db"
    user_groups = []
    if _db.exists():
        _c = _s.connect(str(_db))
        if is_bot_owner:
            user_groups = _c.execute("""SELECT chat_id, title FROM groups
                                        ORDER BY title""").fetchall()
        else:
            try:
                user_groups = _c.execute("""SELECT g.chat_id, g.title FROM groups g
                                            INNER JOIN group_owners go ON g.chat_id = go.chat_id
                                            WHERE go.user_id=?
                                            ORDER BY g.title""",
                                          (uid,)).fetchall()
            except Exception:
                user_groups = []
        _c.close()

    # ═══════════════════════════════════════
    # اگه کاربر مالک گروه نیست یا گروه نداره → پیام کامل توضیحات
    # ═══════════════════════════════════════
    if not user_groups:
        intro = (
            f"🎵 **Sk.Team Music Player**\n"
            f"━━━━━━━━━━━━━━━━━\n"
            f"سلام {u.first_name} 👋\n\n"
            f"من ربات موزیک‌پلیر گروه **Sk.Team** هستم.\n\n"
            f"**🎧 قابلیت‌های من:**\n"
            f"• پخش آهنگ از SoundCloud با کیفیت بالا\n"
            f"• صف پخش (تا ۳۰ آهنگ)\n"
            f"• اکولایزر، سرعت، تکرار، شافل\n"
            f"• پاکسازی پیام‌های گروه\n"
            f"• کنترل صدا و میوت\n\n"
            f"**🎙 ربات رکورد ویس‌کال:**\n"
            f"• ضبط جلسات ویس‌کال گروه\n"
            f"• ارسال به PV مالک گروه\n"
            f"• طول کلیپ قابل تنظیم\n\n"
            f"**⚠️ توجه:**\n"
            f"شما در حال حاضر **اشتراک فعال ندارید**.\n"
            f"برای استفاده از قابلیت‌ها، با سازنده تماس بگیرید."
        )
        kb = InlineKeyboardMarkup([
            [InlineKeyboardButton("📞 تماس با سازنده", url="https://t.me/Siavashska")],
            [InlineKeyboardButton("📢 کانال Sk.Team", url="https://t.me/SkTeamChannel")],
        ])
        await update.message.reply_text(intro, parse_mode="Markdown", reply_markup=kb)
        return

    # ═══════════════════════════════════════
    # کاربر مالک گروه هست → پیام + دکمه /me
    # ═══════════════════════════════════════
    role = "👑 سازنده ربات" if is_bot_owner else "🏢 مالک گروه"
    await update.message.reply_text(
        f"🎵 **Sk.Team Music Player**\n"
        f"━━━━━━━━━━━━━━━━━\n"
        f"سلام {u.first_name} 👋\n"
        f"{role}\n\n"
        f"📊 شما **{len(user_groups)} گروه** دارید.\n"
        f"برای مدیریت گروه‌ها و اشتراک‌ها، روی دکمه زیر بزن:",
        parse_mode="Markdown",
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton("📋 پنل گروه‌های من", callback_data="pv_open")],
            [InlineKeyboardButton("📞 پشتیبانی", url="https://t.me/Siavashska")],
        ]),
    )



async def cmd_ping(update, context):
    t0 = time.time()
    r = await get_srv("/health")
    ms = int((time.time() - t0) * 1000)
    ok = "✅" if r.get("ok") else "❌"
    await update.message.reply_text(
        f"🏓 پونگ! {ms}ms\n{ok} سرور\n📋 صف: {r.get('queue','?')}\n{j_ping()}"
    )

