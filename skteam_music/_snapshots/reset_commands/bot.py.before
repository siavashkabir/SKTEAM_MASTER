async def cmd_panel(update, context):
    """پنل تنظیمات (نه پنل پخش)"""
    uid = update.effective_user.id
    if not await is_owner_or_sudo(uid):
        return  # سایلنت
    cid = update.effective_chat.id
    u = update.effective_user
    chat = update.effective_chat
    is_owner = db.is_owner(uid)
    text, kb = settings_menu.main_menu(cid, chat.title or "—", u.first_name or "—", is_owner)
    m = await update.effective_message.reply_text(text, reply_markup=kb)
    # توی گروه بعد ۹۰ ثانیه پاک بشه
    if update.effective_chat.type in ("group", "supergroup"):
        schedule_delete(context, m, 90)

async def cmd_skin(update, context):
    uid = update.effective_user.id
    if not await is_owner_or_sudo(uid):
        return
    cid = update.effective_chat.id
    s = settings.get(cid)
    rows = []
    for sk in panels.SKINS:
        mark = "✅ " if sk == s["skin"] else ""
        rows.append([InlineKeyboardButton(
            f"{mark}{panels.SKIN_LABELS[sk]}",
            callback_data=f"skin_set:{sk}"
        )])
    rows.append([InlineKeyboardButton("❌ بستن", callback_data="p_close")])
    await update.message.reply_text(
        f"🎨 انتخاب اسکین پنل\nاسکین فعلی: {s['skin']}",
        reply_markup=InlineKeyboardMarkup(rows)
    )

# ─── callback handler ───


async def safe_edit(q, text, kb):
    """edit مطمئن + log"""
    log.warning(f"[EDIT] msg_id={q.message.message_id}")
    has_cap = bool(q.message.caption)
    has_txt = bool(q.message.text)
    log.warning(f"[EDIT] has_cap={has_cap} has_txt={has_txt} len={len(text)}")
    # caption
    try:
        await q.edit_message_caption(caption=text, reply_markup=kb)
        log.warning("[EDIT] ✅ caption")
        return True
    except Exception as e:
        e_l = str(e).lower()
        log.warning(f"[EDIT] cap FAIL: {e}")
        if "not modified" in e_l: return True
    # text
    try:
        await q.edit_message_text(text=text, reply_markup=kb)
        log.warning("[EDIT] ✅ text")
        return True
    except Exception as e:
        e_l = str(e).lower()
        log.warning(f"[EDIT] txt FAIL: {e}")
        if "not modified" in e_l: return True
    return False





async def check_record_subscription(chat_id):
    """چک اشتراک vcall"""
    return _sub_is_active(chat_id, "vcall")

async def get_music_sub_info(chat_id):
    """اطلاعات کامل اشتراک موزیک"""
    return {
        "active": _sub_is_active(chat_id, "music"),
        "days": _sub_days(chat_id, "music"),
    }


async def get_record_sub_info(chat_id):
    """اطلاعات کامل اشتراک vcall"""
    return {
        "active": _sub_is_active(chat_id, "vcall"),
        "days": _sub_days(chat_id, "vcall"),
    }




async def check_music_subscription(chat_id):
    """چک اشتراک موزیک"""
    return _sub_is_active(chat_id, "music")


async def cb_handler(update, context):
    """wrapper با crash log"""
    try:
        await _cb_impl(update, context)
    except Exception as e:
        import traceback
        log.warning(f"[CB_CRASH] {e}\n{traceback.format_exc()}")
        try:
            await update.callback_query.answer(f"err: {e}", show_alert=True)
        except: pass


async def _cb_impl(update, context):
    q = update.callback_query
    data = q.data or ""
    log.warning(f"[CB_HIT] data={data!r}")
    try:
        if q.message:
            reset_panel_timer(q.message.chat.id, q.message.message_id)
    except Exception as _e:
        log.warning(f"[CB_RESET] {_e}")
    try:
        await q.answer()
    except Exception as e:
        log.warning(f"[CB_ANSWER] {e}")
    try:
        cid = q.message.chat.id
        uid = q.from_user.id
        u = q.from_user
    except Exception as e:
        log.warning(f"[CB_PARSE] {e}")
        return
    log.warning(f"[CB_PARSE] cid={cid} uid={uid}")
    await q.answer()
    cid = q.message.chat.id
    uid = q.from_user.id
    u = q.from_user

    # ─── pv_open → همون /me ───
    if data == "pv_open":
        try:
            await q.message.delete()
        except: pass
        # ساخت fake update برای cmd_pv_panel
        await cmd_pv_panel(update, context)
        return

    # ─── PV record ───
    if data.startswith("pvrec_"):
        # فرمت: pvrec_toggle:CHAT_ID یا pvrec_clip:CHAT_ID یا pvrec_close
        if data == "pvrec_close":
            try: await q.message.delete()
            except: pass
            return
        parts = data.split(":")
        action = parts[0]
        target_cid = int(parts[1]) if len(parts) > 1 else 0
        # چک: آیا کاربر مالک این گروه هست؟
        is_owner_of_group = db.is_owner(uid)
        if not is_owner_of_group:
            try:
                import sqlite3 as _s
                _db = Path.home() / "groupbot" / "data" / "groupbot.db"
                _c = _s.connect(str(_db))
                _r = _c.execute("SELECT 1 FROM group_owners WHERE chat_id=? AND user_id=?",
                                (target_cid, uid)).fetchone()
                _c.close()
                is_owner_of_group = bool(_r)
            except: pass
        if not is_owner_of_group:
            await q.answer("شما مالک این گروه نیستید", show_alert=True)
            return
        # چک اشتراک رکورد
        if not await check_record_subscription(target_cid):
            await q.answer("اشتراک رکورد فعال نیست", show_alert=True)
            return
        # toggle یا clip
        if action == "pvrec_toggle":
            import sqlite3 as _s
            _db2 = Path(__file__).parent / "data" / "settings.db"
            _c2 = _s.connect(str(_db2))
            _c2.execute("""CREATE TABLE IF NOT EXISTS record_settings (
                chat_id INTEGER PRIMARY KEY,
                enabled INTEGER DEFAULT 0,
                clip_sec INTEGER DEFAULT 300,
                updated_at INTEGER)""")
            _c2.commit()
            _r = _c2.execute("SELECT enabled, clip_sec FROM record_settings WHERE chat_id=?",
                             (target_cid,)).fetchone()
            cur_en, cur_clip = (_r[0], _r[1]) if _r else (0, 300)
            new_en = 0 if cur_en else 1
            import time as _t
            _c2.execute("""INSERT OR REPLACE INTO record_settings
                (chat_id, enabled, clip_sec, updated_at) VALUES (?,?,?,?)""",
                (target_cid, new_en, cur_clip, int(_t.time())))
            _c2.commit()
            _c2.close()
            action_cmd = "record_start" if new_en else "record_stop"
            await post_cmd({"action": action_cmd, "chat_id": target_cid,
                            "clip_sec": cur_clip})
            await q.answer(f"🎙 {'فعال شد' if new_en else 'خاموش شد'}")
            # reload
            await cmd_pv_panel(update, context)
            return
        if action == "pvrec_clip":
            # نمایش منوی طول کلیپ
            clips = [(60, "۱ دقیقه"), (180, "۳ دقیقه"), (300, "۵ دقیقه"),
                     (600, "۱۰ دقیقه"), (900, "۱۵ دقیقه"),
                     (1800, "۳۰ دقیقه"), (3600, "۱ ساعت")]
            import sqlite3 as _s
            _db2 = Path(__file__).parent / "data" / "settings.db"
            _c2 = _s.connect(str(_db2))
            _r = _c2.execute("SELECT clip_sec FROM record_settings WHERE chat_id=?",
                             (target_cid,)).fetchone()
            _c2.close()
            cur_clip = _r[0] if _r else 300
            rows = []
            for i in range(0, len(clips), 2):
                row = []
                for j in range(2):
                    if i + j < len(clips):
                        sec, lbl = clips[i + j]
                        mk = "✅ " if sec == cur_clip else ""
                        row.append(InlineKeyboardButton(f"{mk}⏱ {lbl}",
                                                        callback_data=f"pvrec_clipset:{target_cid}:{sec}"))
                rows.append(row)
            rows.append([InlineKeyboardButton("🔙 بازگشت", callback_data="pvrec_reload")])
            await safe_edit(q, "⏱ **طول کلیپ ضبط**\n\nانتخاب کن:",
                            InlineKeyboardMarkup(rows))
            return
        if action == "pvrec_clipset":
            sec = int(parts[2])
            import sqlite3 as _s
            _db2 = Path(__file__).parent / "data" / "settings.db"
            _c2 = _s.connect(str(_db2))
            _r = _c2.execute("SELECT enabled FROM record_settings WHERE chat_id=?",
                             (target_cid,)).fetchone()
            cur_en = _r[0] if _r else 0
            import time as _t
            _c2.execute("""INSERT OR REPLACE INTO record_settings
                (chat_id, enabled, clip_sec, updated_at) VALUES (?,?,?,?)""",
                (target_cid, cur_en, sec, int(_t.time())))
            _c2.commit()
            _c2.close()
            # اگه فعاله، restart
            if cur_en:
                await post_cmd({"action": "record_stop", "chat_id": target_cid})
                await asyncio.sleep(0.5)
                await post_cmd({"action": "record_start", "chat_id": target_cid,
                                "clip_sec": sec})
            await q.answer(f"⏱ {sec//60} دقیقه ثبت شد")
            await cmd_pv_panel(update, context)
            return
        if action == "pvrec_reload":
            await cmd_pv_panel(update, context)
            return

    # ─── settings menu ───
    if data.startswith("set:"):
        if not await is_owner_or_sudo(uid):
            await q.answer("دسترسی نداری", show_alert=True); return
        act = data[4:]
        submenu_locks[cid] = __import__('time').time()
        log.warning(f"[SET] act={act} lock={submenu_locks[cid]}")
        chat = q.message.chat
        is_owner = db.is_owner(uid)
        try:
            if act == "back" or act == "main":
                t, k = settings_menu.main_menu(cid, chat.title or "—", u.first_name or "—", is_owner)
                await safe_edit(q, t, k); return
            if act == "skin":
                log.warning("[SKIN] handler شروع")
                submenu_locks[cid] = __import__('time').time()
                try:
                    t, k = settings_menu.skins_menu(cid)
                    log.warning(f"[SKIN] menu len={len(t)}")
                    ok = await safe_edit(q, t, k)
                    log.warning(f"[SKIN] ok={ok}")
                except Exception as e:
                    import traceback
                    log.warning(f"[SKIN_ERR] {e}\n{traceback.format_exc()}")
                return
            if act.startswith("skin_prev:"):
                submenu_locks[cid] = __import__('time').time()
                # پیش‌نمایش
                sk = act.split(":", 1)[1]
                if sk in panels.SKINS:
                    t, k = settings_menu.skins_menu(cid, preview=sk)
                    await safe_edit(q, t, k); return
            if act.startswith("skin_apply:"):
                submenu_locks.pop(cid, None)
                # تایید و اعمال
                sk = act.split(":", 1)[1]
                if sk in panels.SKINS:
                    settings.set_val(cid, "skin", sk)
                    # اگه پنل زنده هست، refresh کن
                    refreshed = False
                    if cid in active_panels:
                        try:
                            s = settings.get(cid)
                            d, _ = await _panel_data(cid)
                            text2, kb = panels.render(s["skin"], d)
                            await context.bot.edit_message_text(
                                text=text2, chat_id=cid,
                                message_id=active_panels[cid]["msg_id"],
                                reply_markup=kb
                            )
                            refreshed = True
                        except Exception as e:
                            log.debug(f"live panel refresh: {e}")
                    msg = f"✅ اسکین «{panels.SKIN_LABELS[sk]}» اعمال شد"
                    if refreshed:
                        msg += "\n🔄 پنل زنده هم آپدیت شد"
                    await q.answer(msg, show_alert=True)
                    # برگشت به منو
                    t, k = settings_menu.skins_menu(cid)
                    await safe_edit(q, t, k); return
            if act.startswith("skin:"):
                sk = act.split(":", 1)[1]
                if sk in panels.SKINS:
                    settings.set_val(cid, "skin", sk)
                    t, k = settings_menu.skins_menu(cid)
                    await q.edit_message_text(t, reply_markup=k); return
            if act == "sub":
                t, k = settings_menu.sub_menu(cid)
                await safe_edit(q, t, k); return
            if act == "player":
                t, k = settings_menu.player_menu(cid)
                await safe_edit(q, t, k); return
            if act == "tools":
                t, k = settings_menu.tools_menu(cid)
                await safe_edit(q, t, k); return
            if act == "stats":
                t, k = settings_menu.stats_menu(cid)
                await safe_edit(q, t, k); return
            if act == "gifs":
                t, k = settings_menu.gifs_menu(cid)
                await safe_edit(q, t, k); return
            if act == "gif_toggle":
                s = settings.get(cid)
                settings.set_val(cid, "gif_enabled", 0 if s["gif_enabled"] else 1)
                t, k = settings_menu.gifs_menu(cid)
                await safe_edit(q, t, k); return
            if act == "gif_add":
                gif_add_wait[cid] = True
                await q.edit_message_text(
                    "📤 حالا گیفت رو بفرست\n"
                    "هر GIF، mp4 یا عکس بفرستی ذخیره می‌شه\n\n"
                    "برای لغو: /cancel",
                    reply_markup=InlineKeyboardMarkup([
                        [InlineKeyboardButton("🔙 انصراف", callback_data="set:gifs")]
                    ])
                ); return
            if act.startswith("gif_act:"):
                gid = int(act.split(":", 1)[1])
                import gifs as gifs_mod
                gifs_mod.set_active(cid, gid)
                t, k = settings_menu.gifs_menu(cid)
                await safe_edit(q, t, k); return
            if act.startswith("gif_del:"):
                gid = int(act.split(":", 1)[1])
                import gifs as gifs_mod
                gifs_mod.delete(cid, gid)
                t, k = settings_menu.gifs_menu(cid)
                await safe_edit(q, t, k); return
            # ─── RECORD ───
            if act == "rec":
                t, k = settings_menu.record_menu(cid)
                await safe_edit(q, t, k); return
            if act == "rec_toggle":
                import sqlite3
                _db = Path(__file__).parent / "data" / "settings.db"
                _c = sqlite3.connect(str(_db))
                _c.execute("""CREATE TABLE IF NOT EXISTS record_settings (
                    chat_id INTEGER PRIMARY KEY,
                    enabled INTEGER DEFAULT 0,
                    clip_sec INTEGER DEFAULT 300,
                    updated_at INTEGER)""")
                _c.commit()
                _r = _c.execute("SELECT enabled, clip_sec FROM record_settings WHERE chat_id=?",
                                (cid,)).fetchone()
                cur_en = _r[0] if _r else 0
                cur_clip = _r[1] if _r else 300
                new_en = 0 if cur_en else 1
                import time as _t
                _c.execute("""INSERT OR REPLACE INTO record_settings
                    (chat_id, enabled, clip_sec, updated_at) VALUES (?,?,?,?)""",
                    (cid, new_en, cur_clip, int(_t.time())))
                _c.commit()
                _c.close()
                # ارسال به player
                action = "record_start" if new_en else "record_stop"
                await post_cmd({
                    "action": action,
                    "chat_id": cid,
                    "clip_sec": cur_clip,
                })
                lbl = "✅ فعال شد" if new_en else "⏹ خاموش شد"
                await send_notification(context, cid, f"🎙 ضبط: {lbl}", 5)
                await update_pin(context, cid, f"🎙 ضبط ویس‌کال: {lbl}")
                t, k = settings_menu.record_menu(cid)
                await safe_edit(q, t, k); return
            if act == "rec_clip":
                t, k = settings_menu.record_clip_menu(cid)
                await safe_edit(q, t, k); return
            if act.startswith("rec_clip_set:"):
                sec = int(act.split(":", 1)[1])
                import sqlite3
                _db = Path(__file__).parent / "data" / "settings.db"
                _c = sqlite3.connect(str(_db))
                _c.execute("""CREATE TABLE IF NOT EXISTS record_settings (
                    chat_id INTEGER PRIMARY KEY,
                    enabled INTEGER DEFAULT 0,
                    clip_sec INTEGER DEFAULT 300,
                    updated_at INTEGER)""")
                _c.commit()
                _r = _c.execute("SELECT enabled, clip_sec FROM record_settings WHERE chat_id=?",
                                (cid,)).fetchone()
                cur_en = _r[0] if _r else 0
                import time as _t
                _c.execute("""INSERT OR REPLACE INTO record_settings
                    (chat_id, enabled, clip_sec, updated_at) VALUES (?,?,?,?)""",
                    (cid, cur_en, sec, int(_t.time())))
                _c.commit()
                _c.close()
                # اگه فعاله، با clip جدید دوباره شروع کن
                if cur_en:
                    await post_cmd({"action": "record_stop", "chat_id": cid})
                    await asyncio.sleep(0.5)
                    await post_cmd({"action": "record_start", "chat_id": cid,
                                    "clip_sec": sec})
                await send_notification(context, cid,
                                        f"⏱ طول کلیپ: {sec//60} دقیقه", 5)
                t, k = settings_menu.record_menu(cid)
                await safe_edit(q, t, k); return

            if act == "close":
                submenu_locks.pop(cid, None)
                active_panels.pop(cid, None)
                try: await q.message.delete()
                except: pass
                return
            if act.startswith("cfg_"):
                key = act[4:]
                s = settings.get(cid)
                if key == "refresh":
                    vals = [3, 5, 10, 15, 30]
                    cur = s["refresh_sec"]
                    nxt = vals[(vals.index(cur) + 1) % len(vals)] if cur in vals else 5
                    settings.set_val(cid, "refresh_sec", nxt)
                elif key == "delete":
                    vals = [0, 20, 40, 60, 120]
                    cur = s["auto_delete_sec"]
                    nxt = vals[(vals.index(cur) + 1) % len(vals)] if cur in vals else 40
                    settings.set_val(cid, "auto_delete_sec", nxt)
                elif key == "gif":
                    settings.set_val(cid, "gif_enabled", 0 if s["gif_enabled"] else 1)
                t, k = settings_menu.player_menu(cid)
                await safe_edit(q, t, k); return
            if act == "tool_reset":
                await q.answer("ریست...")
                await post_cmd({"action": "reset_player", "chat_id": cid})
                return
            if act == "tool_health":
                r = await get_srv("/health")
                await q.answer(f"صف: {r.get('queue','?')}", show_alert=True); return
            if act == "tool_resetcurrent":
                try:
                    async with httpx.AsyncClient(timeout=5) as h:
                        r = await h.post(f"{SK_SERVER}/reset-current")
                        d = r.json()
                    await q.answer(
                        f"✅ پاک شد: {d.get('cleared',0)} current + {d.get('queued',0)} صف",
                        show_alert=True
                    )
                    # بستن پنل‌های زنده
                    if cid in active_panels:
                        try:
                            await context.bot.delete_message(
                                cid, active_panels[cid]["msg_id"])
                        except: pass
                        active_panels.pop(cid, None)
                except Exception as e:
                    await q.answer(f"❌ {e}", show_alert=True)
                return
        except Exception as e:
            log.warning(f"settings cb err: {e}")
        return

    # ─── player controls (pl:) ───

    # skin choose
    if data.startswith("skin_set:"):
        if not await is_owner_or_sudo(uid):
            await q.answer("دسترسی نداری", show_alert=True); return
        sk = data.split(":", 1)[1]
        if sk in panels.SKINS:
            settings.set_val(cid, "skin", sk)
            try: await q.edit_message_text(f"✅ اسکین روی «{panels.SKIN_LABELS[sk]}» تنظیم شد")
            except: pass
        return

    if data == "pl:close":
        submenu_locks.pop(cid, None)
        try: await q.message.delete()
        except: pass
        return

    # ─── کنترل‌های پنل پخش: برای همه مجازها ───
    if data.startswith("pl:"):
        if not await can_play(uid, cid):
            await q.answer("دسترسی نداری", show_alert=True); return

    # control actions
    action_map = {
        "pl:pause":   "pause",
        "pl:resume":  "resume",
        "pl:next":    "next",
        "pl:prev":    "previous",
        "pl:stop":    "stop",
        "pl:vu":      "volume_up",
        "pl:vd":      "volume_down",
        "pl:mute":    "mute",
        "pl:unmute":  "unmute",
        "pl:rep":     "cycle_repeat",
        "pl:shuf":    "toggle_shuffle",
    }
    if data == "pl:refresh":
        await open_panel(update, context, from_cb=True); return

    # ─── دانلود فایل ───
    if data in ("pl:dl128", "pl:dl320"):
        submenu_locks[cid] = __import__('time').time()
        quality = 128 if data == "pl:dl128" else 320
        await q.answer(f"دانلود {quality}K شروع شد...")
        try:
            await q.edit_message_text(
                f"📥 در حال دانلود {quality}K\n⏳ لطفاً صبر کنید...",
                reply_markup=InlineKeyboardMarkup([
                    [InlineKeyboardButton("🔙 بازگشت", callback_data="pl:back")],
                ])
            )
        except: pass
        await post_cmd({
            "action": "download_file",
            "chat_id": cid,
            "quality": quality,
            "user_id": uid,
        })
        return

    # ─── بازگشت به پنل از زیرمنو ───
    if data == "pl:back":
        try:
            s = settings.get(cid)
            data_p, _ = await _panel_data(cid)
            text, kb = panels.render(s["skin"], data_p)
            await q.edit_message_text(text, reply_markup=kb)
        except Exception as e:
            log.warning(f"back err: {e}")
        return
    if data == "pl:eq":
        submenu_locks[cid] = __import__('time').time()
        # ★ پریست فعلی
        try:
            d, _ = await _panel_data(cid)
            cur_eq = (d.get("eq") or "off").lower()
        except:
            cur_eq = "off"
        presets = [
            ("rock", "🎸 Rock"), ("jazz", "🎷 Jazz"), ("pop", "🎤 Pop"),
            ("classic", "🎻 Classic"), ("bass", "🔊 Bass Boost"),
            ("treble", "🎼 Treble"), ("vocal", "🎵 Vocal"),
            ("3d", "🌌 3D"), ("wide", "🔊 Wide"),
            ("night", "🌙 شب"), ("day", "☀️ روز"),
            ("silent", "🔇 سکوت"),
            ("dance", "💃 Dance"), ("hiphop", "🎧 Hip-Hop"),
            ("heavy", "🤘 Heavy"), ("acoustic", "🎸 Acoustic"),
        ]
        rows = []
        # 2 تا در هر ردیف
        for i in range(0, len(presets), 2):
            row = []
            for j in range(2):
                if i + j < len(presets):
                    k, lbl = presets[i + j]
                    mark = "✅ " if k == cur_eq else ""
                    row.append(InlineKeyboardButton(
                        f"{mark}{lbl}", callback_data=f"pl:eq:{k}"
                    ))
            rows.append(row)
        rows.append([InlineKeyboardButton("⭕️ خاموش کردن EQ", callback_data="pl:eq:off")])
        rows.append([InlineKeyboardButton("🔙 بازگشت", callback_data="pl:back")])
        await safe_edit(q,
            f"🎚 اکولایزر Sk.Team\n"
            f"━━━━━━━━━━━━━━━\n"
            f"🎯 فعال: {cur_eq.upper()}\n\n"
            f"پریست مورد نظر:",
            InlineKeyboardMarkup(rows)
        )
        return

    if data.startswith("pl:eq:"):
        submenu_locks[cid] = __import__('time').time()
        eq_name = data.split(":", 2)[2]
        # ★ ارسال به سرور
        await post_cmd({"action": "eq", "chat_id": cid, "eq": eq_name})
        # ★ اعلان در pin (نوتیف بار)
        lbl_map = {
            "rock":"🎸 Rock","jazz":"🎷 Jazz","pop":"🎤 Pop","classic":"🎻 Classic",
            "bass":"🔊 Bass Boost","treble":"🎼 Treble","vocal":"🎵 Vocal",
            "3d":"🌌 3D","wide":"🔊 Wide","night":"🌙 شب","day":"☀️ روز",
            "silent":"🔇 سکوت","dance":"💃 Dance","hiphop":"🎧 Hip-Hop",
            "heavy":"🤘 Heavy","acoustic":"🎸 Acoustic","off":"⭕️ خاموش"
        }
        lbl = lbl_map.get(eq_name, eq_name)
        # ★ pin notification
        await update_pin(context, cid, f"🎚 حالت صوتی: {lbl}")
        await send_notification(context, cid, f"🎚 {lbl}\n✅ اعمال شد", 8)
        # ★ قفل زیرمنو — تا کاربر ببینه
        # بعد از ۲۵ ثانیه (ffmpeg re-process)، دکمه‌ها refresh می‌شن
        # فعلاً فقط refresh کن
        await asyncio.sleep(1)
        # refresh منو با تیک
        try:
            cur_eq = eq_name
            presets = [
                ("rock", "🎸 Rock"), ("jazz", "🎷 Jazz"), ("pop", "🎤 Pop"),
                ("classic", "🎻 Classic"), ("bass", "🔊 Bass Boost"),
                ("treble", "🎼 Treble"), ("vocal", "🎵 Vocal"),
                ("3d", "🌌 3D"), ("wide", "🔊 Wide"),
                ("night", "🌙 شب"), ("day", "☀️ روز"),
                ("silent", "🔇 سکوت"),
                ("dance", "💃 Dance"), ("hiphop", "🎧 Hip-Hop"),
                ("heavy", "🤘 Heavy"), ("acoustic", "🎸 Acoustic"),
            ]
            rows = []
            for i in range(0, len(presets), 2):
                row = []
                for j in range(2):
                    if i + j < len(presets):
                        k, l = presets[i + j]
                        mark = "✅ " if k == cur_eq else ""
                        row.append(InlineKeyboardButton(f"{mark}{l}", callback_data=f"pl:eq:{k}"))
                rows.append(row)
            rows.append([InlineKeyboardButton("⭕️ خاموش کردن EQ", callback_data="pl:eq:off")])
            rows.append([InlineKeyboardButton("🔙 بازگشت", callback_data="pl:back")])
            await safe_edit(q,
                f"🎚 اکولایزر Sk.Team\n"
                f"━━━━━━━━━━━━━━━\n"
                f"🎯 فعال: {lbl}\n\n"
                f"🔄 در حال اعمال... (۱۰-۲۰s)",
                InlineKeyboardMarkup(rows)
            )
        except Exception as e:
            log.debug(f"eq menu refresh: {e}")
        return
    if data == "pl:queue":
        submenu_locks[cid] = __import__('time').time()
        try:
            import httpx as _hx
            async with _hx.AsyncClient(timeout=5) as _ch:
                _r = await _ch.get(f"{SK_SERVER}/queue/list", params={"chat_id": cid})
                _d = _r.json()
            _items = _d.get("items", [])
            if not _items:
                _t = "📋 صف پخش\n\n🕳 صف خالیه"
            else:
                _lines = ["📋 صف پخش (" + str(len(_items)) + ")", ""]
                for i, it in enumerate(_items[:15], 1):
                    _lines.append(f"{i}. {str(it.get('query','?'))[:40]}")
                if len(_items) > 15:
                    _lines.append(f"... و {len(_items)-15} دیگه")
                _t = "\n".join(_lines)
            await safe_edit(q, _t, InlineKeyboardMarkup([
                [InlineKeyboardButton("🔙 بازگشت", callback_data="pl:back")],
                [InlineKeyboardButton("❌ بستن", callback_data="pl:close")],
            ]))
        except Exception as _e:
            log.warning(f"queue err: {_e}")
        return
    # ─── seek ───
    seek_map = {
        "pl:seek_b60": ("back", 60),
        "pl:seek_b30": ("back", 30),
        "pl:seek_f30": ("fwd", 30),
        "pl:seek_f60": ("fwd", 60),
    }
    if data in seek_map:
        direction, secs = seek_map[data]
        await send_seek(cid, direction, secs)
        # notification
        arrow = "⏩" if direction == "fwd" else "⏪"
        label = "جلو" if direction == "fwd" else "عقب"
        await send_notification(context, cid, f"{arrow} {secs}s {label}", 3)
        await asyncio.sleep(0.3)
        try:
            s = settings.get(cid)
            d, _ = await _panel_data(cid)
            text, kb = panels.render(s["skin"], d)
            await q.edit_message_text(text, reply_markup=kb)
        except Exception as e:
            if "not modified" not in str(e).lower():
                log.debug(f"seek refresh: {e}")
        return

    # ─── speed ───
    if data == "pl:spd_dn":
        log.warning(f"[SPD_DN] cid={cid}")
        try: await q.answer("⚡ -0.25x")
        except: pass
        await send_speed(cid, delta=-0.25)
        await asyncio.sleep(0.5)
        try:
            d, _ = await _panel_data(cid)
            await send_notification(context, cid, f"⚡ سرعت: {d.get('speed', 1.0)}x", 3)
        except: pass
        return
    if data == "pl:spd_up":
        await send_speed(cid, delta=0.25)
        await asyncio.sleep(0.3)
        try:
            d, _ = await _panel_data(cid)
            await send_notification(context, cid, f"⚡ سرعت: {d.get('speed', 1.0)}x", 3)
        except: pass
        try:
            s = settings.get(cid)
            d, _ = await _panel_data(cid)
            text, kb = panels.render(s["skin"], d)
            await q.edit_message_text(text, reply_markup=kb)
        except: pass
        return
    if data == "pl:spd_reset":
        await send_speed(cid, reset=True)
        await asyncio.sleep(0.3)
        try:
            s = settings.get(cid)
            d, _ = await _panel_data(cid)
            text, kb = panels.render(s["skin"], d)
            await q.edit_message_text(text, reply_markup=kb)
        except: pass
        return

    act = action_map.get(data)
    if act:
        # ─── notification text ───
        notif_text = None
        # حالت mute/unmute
        if act == "mute":
            notif_text = "🔇 پلیر بی‌صدا شد"
        elif act == "unmute":
            notif_text = "🔊 پلیر باصدا شد"
        # اگه stop → پنل بسته
        if act == "stop":
            await post_cmd({"action": act, "chat_id": cid})
            # ★ FIX: صف هم پاک شه
            try:
                async with httpx.AsyncClient(timeout=5) as _h:
                    await _h.post(f"{SK_SERVER}/queue/clear", json={"chat_id": cid})
                log.info(f"[STOP-CB] queue cleared for {cid}")
            except Exception as _e:
                log.warning(f"[STOP-CB] queue clear err: {_e}")
            try: await q.message.delete()
            except: pass
            if notif_text:
                await send_notification(context, cid, notif_text, 3)
            # پاک کردن pin
            if cid in pinned_msgs:
                try:
                    await context.bot.unpin_chat_message(cid, pinned_msgs[cid])
                except: pass
                pinned_msgs.pop(cid, None)
            return
        # ارسال به سرور
        await post_cmd({"action": act, "chat_id": cid})
        # ★ برای next: فقط 0.5 ثانیه صبر
        await asyncio.sleep(0.5)

        # ─── notification با اطلاعات فعلی ───
        try:
            s = settings.get(cid)
            d, _ = await _panel_data(cid)
            if act == "volume_up":
                notif_text = f"🔊 صدا: {d.get('volume', '?')}%"
            elif act == "volume_down":
                notif_text = f"🔉 صدا: {d.get('volume', '?')}%"
            elif act == "pause":
                notif_text = "⏸ پلیر متوقف شد"
            elif act == "resume":
                notif_text = "▶️ پلیر ادامه داد"
            elif act == "next":
                notif_text = "⏭ آهنگ بعدی"
            elif act == "cycle_repeat":
                notif_text = f"🔁 تکرار: {d.get('repeat', 'off')}"
            elif act == "toggle_shuffle":
                notif_text = f"🔀 شافل: {'روشن' if d.get('shuffle') else 'خاموش'}"
        except: pass

        if notif_text:
            # ★ در pin بذار (نوتیف بار)
            await update_pin(context, cid, notif_text)
            # ★ و در چت هم (که کاربر رد بشه)
            await send_notification(context, cid, notif_text, 3)
        # refresh پنل
        s = settings.get(cid)
        d, _ = await _panel_data(cid)
        text, kb = panels.render(s["skin"], d)
        await safe_edit(q, text, kb)
        return

# ─── main msg handler ───
def _get_owner_call_names(chat_id):
    """اسم‌های مالکین برای صدا زدن"""
    names = []
    try:
        import sqlite3 as _s
        from pathlib import Path as _P
        _db = _P.home() / "skteam_music" / "data" / "settings.db"
        conn = _s.connect(str(_db), timeout=5)
        rows = conn.execute("SELECT first_name, username FROM sk_group_owners WHERE chat_id=?", (chat_id,)).fetchall()
        conn.close()
        for fn, un in rows:
            if fn: names.append(fn.lower().strip())
            if un: names.append(un.lower().strip())
    except Exception as e:
        import logging
        logging.getLogger("SktTeam").warning("[CALL] " + str(e))
    return names



async def msg_handler(update, context):
    m = update.effective_message
    if not m or not m.text: return
    # ─── توی PV ───
    chat = update.effective_chat
    if chat and chat.type == "private":
        raw = m.text.strip()
        # اگه دستور /me یا /mygroups نبود → پیام اشتراک
        if raw.lower() not in ("پنل", "پنل من", "/me", "/mygroups", "me", "mygroups"):
            uid = update.effective_user.id
            is_bot_owner = db.is_owner(uid)
            if not is_bot_owner:
                # چک مالک گروه
                import sqlite3 as _s
                _db = Path.home() / "groupbot" / "data" / "groupbot.db"
                has_group = False
                try:
                    _c = _s.connect(str(_db))
                    _r = _c.execute("""SELECT 1 FROM group_owners
                                       WHERE user_id=? LIMIT 1""",
                                    (uid,)).fetchone()
                    _c.close()
                    has_group = bool(_r)
                except: pass
                if not has_group:
                    await m.reply_text(
                        "❌ **اشتراک فعال ندارید**\n"
                        "━━━━━━━━━━━━━━━━━\n"
                        "برای خرید اشتراک موزیک‌پلیر یا رکورد\n"
                        "با @Siavashska تماس بگیرید.",
                        parse_mode="Markdown",
                    )
                    return
                else:
                    # مالک گروه → راهنما
                    await m.reply_text(
                        "📋 برای دیدن گروه‌هات: /me\n"
                        "برای پشتیبانی: @Siavashska"
                    )
                    return
            else:
                # سازنده → راهنما
                await m.reply_text(
                    "👑 سلام سازنده\n"
                    "📋 برای دیدن همه گروه‌ها: /me"
                )
                return
    import logging as _lg
    _lg.getLogger("MSG_IN").warning(
        "[MSG_IN] chat=%s type=%s user=%s text=%r",
        m.chat.id, m.chat.type, m.from_user.id if m.from_user else None, m.text[:80]
    )
    chat = update.effective_chat; user = update.effective_user
    if not chat or not user: return
    cid = chat.id; uid = user.id
    raw = m.text.strip(); text = fa2en(raw)
    in_group = chat.type in ("group", "supergroup")

    # ─── پنل تنظیمات ───
    # ─── صدا زدن ربات ───


    CALL_WORDS = {"ربات", "ربات?", "ربات؟", "ربات!", "ربات جان",
                  "بات", "بات?", "بات؟",
                  "bot", "Bot", "BOT"}
    _owner_names = _get_owner_call_names(cid)
    _raw_low = raw.lower().strip()
    if raw in CALL_WORDS or _raw_low in ("bot", "robot") or _raw_low in _owner_names:
        _io = db.is_owner(uid)
        _cp = await can_play(uid, cid)
        _is = await is_owner_or_sudo(uid)
        log.warning(f"[CALL] uid={uid} owner={_io} cp={_cp} sudo={_is}")
        if _io:
            sent = await m.reply_text(j_call_owner())
        elif _cp or _is:
            sent = await m.reply_text(j_call_user(uid, cid))
        else:
            log.warning("[CALL] silent")
            return
        if in_group and sent:
            schedule_delete(context, sent, 20)
        return

    if raw in ("پنل", "تنظیمات", "پنل تنظیمات"):
        if not await is_owner_or_sudo(uid):
            return  # سایلنت
        is_owner = db.is_owner(uid)
        text, kb = settings_menu.main_menu(cid, chat.title or "—", user.first_name or "—", is_owner)
        sent = await m.reply_text(text, reply_markup=kb)
        if in_group: schedule_delete(context, sent, 90)
        return

    # ─── پنل پخش ───
    if raw in ("پلیر", "پخش زنده", "np", "player"):
        if not await can_play(uid, cid):
            if not in_group: await m.reply_text(j_notauth())
            return
        await open_live_panel(context.bot, cid, uid)
        return

    q = parse_play(raw)
    if q:
        # ★ چک اشتراک موزیک
        if not await check_music_subscription(cid):
            sent = await m.reply_text(
                "❌ **اشتراک موزیک این گروه فعال نیست**\n"
                "━━━━━━━━━━━━━━━━━\n"
                "برای خرید یا تمدید:\n"
                "👤 @Siavashska",
                parse_mode="Markdown",
            )
            if in_group: schedule_delete(context, sent, 30)
            return
        if not await can_play(uid, cid):
            if not in_group: await m.reply_text(j_notauth())
            return

        # ─── چک کن چیزی پخش می‌شه یا صف غیرخالی ───
        now = await get_srv("/now-playing", {"chat_id": cid})
        is_playing = bool(now.get("playing"))

        # ★ چک صف
        queue_size = 0
        try:
            import httpx
            async with httpx.AsyncClient(timeout=5) as _h:
                _r = await _h.get(f"{SK_SERVER}/queue/list", params={"chat_id": cid})
                queue_size = len(_r.json().get("items", []))
        except Exception as e:
            log.debug(f"queue check: {e}")

        # اگه پخش فعاله یا صف غیرخالیه → اضافه به صف
        if is_playing or queue_size > 0:
            # ─── در حال پخش → اضافه به صف ───
            size = await add_to_queue(cid, q, uid, user.first_name or "")
            sent = await m.reply_text(
                f"➕ به صف اضافه شد (#{size})\n🎵 {q}"
            )
            if in_group: schedule_delete(context, sent, 30)
            # ★ فقط پنل موجود رو ادیت کن، پنل جدید نساز
            if cid in active_panels:
                try:
                    s = settings.get(cid)
                    d, _ = await _panel_data(cid)
                    text, kb = panels.render(s["skin"], d)
                    await context.bot.edit_message_text(
                        text=text, chat_id=cid,
                        message_id=active_panels[cid]["msg_id"],
                        reply_markup=kb
                    )
                except Exception as e:
                    log.debug(f"panel refresh (queue): {e}")
                    active_panels.pop(cid, None)
        else:
            # ─── چیزی پخش نمی‌شه → فوری پخش ───
            r = await post_cmd({"action": "play", "chat_id": cid,
                                "query": q, "requested_by": uid,
                                "requested_by_name": user.first_name or ""})
            if r.get("ok"):
                sent = await m.reply_text(f"🎵 {q}\n{j_play(uid, cid)}")
                if in_group: schedule_delete(context, sent, 15)
                try:
                    await asyncio.sleep(2)
                    await open_live_panel(context.bot, cid, uid)
                except Exception as e:
                    log.warning(f"live panel err: {e}")
            else:
                sent = await m.reply_text(f"{j_err()}")
                if in_group: schedule_delete(context, sent, 40)
        return

    controls = {
        "توقف": ("stop", lambda: j_stop(uid, cid), 25), "بس کن": ("stop", lambda: j_stop(uid, cid), 25), "استاپ": ("stop", lambda: j_stop(uid, cid), 25),
        "مکث": ("pause", lambda: j_pause(uid, cid), 25), "پاز": ("pause", lambda: j_pause(uid, cid), 25),
        "ادامه": ("resume", lambda: j_resume(uid, cid), 25), "continue": ("resume", lambda: j_resume(uid, cid), 25),
        "بعدی": ("next", lambda: j_next(uid, cid), 25), "next": ("next", lambda: j_next(uid, cid), 25), "skip": ("next", lambda: j_next(uid, cid), 25),
        "قبلی": ("previous", None, 25), "prev": ("previous", None, 25),
    }
    if raw in controls:
        if not await can_play(uid, cid):
            if not in_group: await m.reply_text(j_notauth())
            return
        act, jf, sec = controls[raw]
        await post_cmd({"action": act, "chat_id": cid})
        # ★ FIX: اگه stop بود، صف رو پاک کن
        if act == "stop":
            try:
                async with httpx.AsyncClient(timeout=5) as _h:
                    await _h.post(f"{SK_SERVER}/queue/clear", json={"chat_id": cid})
                log.info(f"[STOP] queue cleared for {cid}")
            except Exception as _e:
                log.warning(f"[STOP] queue clear err: {_e}")
        # ─── اگه stop بود، پنل رو ببند ───
        if act == "stop" and cid in active_panels:
            try: await close_live_panel(context.bot, cid)
            except: pass
        msg_txt = jf() if jf else f"⏮ {act}"
        sent = await m.reply_text(msg_txt)
        if in_group: schedule_delete(context, sent, sec)
        return

    mv = VOL_RE.match(text)
    if mv:
        if not await can_play(uid, cid):
            if not in_group: await m.reply_text(j_notauth())
            return
        v = max(1, min(200, int(mv.group(1))))
        await post_cmd({"action": "volume", "chat_id": cid, "volume": v})
        await update_pin(context, cid, f"🔊 صدا: {v}%")
        sent = await m.reply_text(f"🔊 صدا: {v}%\n{j_vol()}")
        if in_group: schedule_delete(context, sent, 5)
        # پنل رو refresh کن
        try:
            if cid in active_panels:
                s = settings.get(cid)
                d, _ = await _panel_data(cid)
                text2, kb = panels.render(s["skin"], d)
                await context.bot.edit_message_text(
                    text=text2, chat_id=cid,
                    message_id=active_panels[cid]["msg_id"],
                    reply_markup=kb
                )
        except: pass
        return

    if raw in ("چی پخشه؟", "چی پخشه", "الان چی پخشه", "np"):
        r = await get_srv("/now-playing", {"chat_id": cid})
        if r.get("playing"):
            sent = await m.reply_text(f"🎵 {r.get('title','?')}\n⏱ {r.get('duration',0)}s")
        else:
            sent = await m.reply_text("🤷 چیزی پخش نمی‌شه")
        if in_group: schedule_delete(context, sent, 30)
        return

    if raw.lower() == "پینگ":
        t0 = time.time()
        r = await get_srv("/health")
        ms = int((time.time() - t0) * 1000)
        ok = "✅" if r.get("ok") else "❌"
        sent = await m.reply_text(f"🏓 {ms}ms {ok}\n📋 صف: {r.get('queue','?')}")
        if in_group: schedule_delete(context, sent, 30)
        return

# ─── register ───
async def cmd_player(update, context):
    """پنل پخش (live panel) - برای همه مجازها"""
    uid = update.effective_user.id
    cid = update.effective_chat.id
    if not await can_play(uid, cid):
        return  # سایلنت
    await open_live_panel(context.bot, cid, uid)



async def file_reply_handler(update, context):
    """وقتی کاربر روی فایل صوتی/ویدیو ریپلای می‌کنه و می‌نویسه پخش"""
    m = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not m or not chat or not user: return
    if not m.text: return
    raw = m.text.strip()
    # باید ریپلای باشه و کلمه پخش
    if not m.reply_to_message: return
    if raw not in ("پخش", "پخش کن", "پلی", "بزن", "play"): return

    cid = chat.id
    uid = user.id
    # ★ چک اشتراک موزیک
    if not await check_music_subscription(cid):
        await m.reply_text(
            "❌ **اشتراک موزیک این گروه فعال نیست**\n"
            "👤 @Siavashska",
            parse_mode="Markdown",
        )
        return
    if not await can_play(uid, cid):
        if chat.type not in ("group", "supergroup"):
            await m.reply_text(j_notauth())
        return

    # file_id از پیام ریپلای
    rm = m.reply_to_message
    file_id = None
    title = "voice"
    if rm.audio:
        file_id = rm.audio.file_id
        title = rm.audio.title or rm.audio.file_name or "audio"
    elif rm.voice:
        file_id = rm.voice.file_id
        title = "voice"
    elif rm.video:
        file_id = rm.video.file_id
        title = rm.video.file_name or "video"
    elif rm.document:
        file_id = rm.document.file_id
        title = rm.document.file_name or "document"
    if not file_id:
        return

    # ارسال به سرور به عنوان file
    now = await get_srv("/now-playing", {"chat_id": cid})
    is_playing = bool(now.get("playing"))

    # ★★ دانلود فایل با Bot API → مسیر محلی ──
    sent = await m.reply_text("📥 دانلود فایل...")
    try:
        import os as _os
        tg_file = await context.bot.get_file(file_id)
        out_dir = _os.path.expanduser("~/sk_media/tg_files")
        _os.makedirs(out_dir, exist_ok=True)
        # extension از فایل اصلی
        ext = ".mp3"
        if rm.audio and rm.audio.file_name:
            ext = _os.path.splitext(rm.audio.file_name)[1] or ".mp3"
        elif rm.video and rm.video.file_name:
            ext = _os.path.splitext(rm.video.file_name)[1] or ".mp4"
        elif rm.document and rm.document.file_name:
            ext = _os.path.splitext(rm.document.file_name)[1] or ".mp3"
        safe = "".join(ch for ch in title if ch.isalnum() or ch in " -_")[:40]
        local_name = f"{int(time.time())}_{safe}{ext}"
        local_path = _os.path.join(out_dir, local_name)
        await tg_file.download_to_drive(local_path)
        log.warning(f"[TG_DL] saved: {local_path}")
    except Exception as e:
        log.warning(f"[TG_DL] err: {e}")
        sent2 = await m.reply_text(f"❌ دانلود نشد: {e}")
        schedule_delete(context, sent2, 20)
        return
    try: await sent.delete()
    except: pass

    # ★★ مسیر محلی Ubuntu ──
    ub_path = local_path.replace(
        _os.path.expanduser("~"),
        "/data/data/com.termux/files/home"
    )
    file_query = f"LOCAL|{ub_path}|{title[:100]}"
    log.warning(f"[TG_DL] ub_path={ub_path}")

    if is_playing:
        size = await add_to_queue(cid, file_query, uid, user.first_name or "")
        sent = await m.reply_text(f"➕ فایل به صف اضافه شد (#{size})\n🎵 {title[:40]}")
    else:
        await post_cmd({
            "action": "play",
            "chat_id": cid,
            "query": file_query,
            "requested_by": uid,
            "requested_by_name": user.first_name or "",
        })
        sent = await m.reply_text(f"🎵 فایل در حال پخش: {title[:40]}")
        # ★ باز کردن پنل زنده
        try:
            await asyncio.sleep(2)
            await open_live_panel(context.bot, cid, uid)
        except Exception as e:
            log.warning(f"file live panel err: {e}")
    if chat.type in ("group", "supergroup"):
        schedule_delete(context, sent, 30)




async def gif_upload_handler_debug(update, context):
    """debug همه پیام‌های غیرمتنی"""
    import logging as _lg
    m = update.effective_message
    chat = update.effective_chat
    if not m or not chat: return
    _lg.getLogger("GIF_DBG").warning(
        f"[ALL_NONTEXT] chat={chat.id} "
        f"anim={bool(m.animation)} vid={bool(m.video)} "
        f"doc={bool(m.document)} photo={bool(m.photo)} "
        f"voice={bool(m.voice)} sticker={bool(m.sticker)} "
        f"wait={gif_add_wait.get(chat.id)}"
    )


async def gif_upload_handler(update, context):
    """وقتی کاربر GIF/mp4/عکس می‌فرسته برای ذخیره"""
    import logging as _lg
    m = update.effective_message
    chat = update.effective_chat
    user = update.effective_user
    if not m or not chat or not user:
        return
    cid = chat.id

    # ─── Debug همیشه ───
    _lg.getLogger("GIF").warning(
        f"[GIF_IN] chat={cid} uid={user.id} wait={gif_add_wait.get(cid)} "
        f"anim={bool(m.animation)} vid={bool(m.video)} doc={bool(m.document)} photo={bool(m.photo)}"
    )

    # ─── اگه منتظر نیستیم، برو ───
    if not gif_add_wait.get(cid):
        return
    if not await is_owner_or_sudo(user.id):
        return

    # ─── ★ فوری flag رو بردار تا دوبار پردازش نشه ───
    gif_add_wait[cid] = False

    # ─── فایل رو استخراج کن ───
    file_id = None
    fname = "gif"
    if m.animation:
        file_id = m.animation.file_id
        fname = m.animation.file_name or f"anim_{int(time.time())}"
    elif m.video:
        file_id = m.video.file_id
        fname = m.video.file_name or f"video_{int(time.time())}"
    elif m.document:
        file_id = m.document.file_id
        fname = m.document.file_name or f"doc_{int(time.time())}"
    elif m.photo:
        file_id = m.photo[-1].file_id
        fname = f"photo_{int(time.time())}"

    _lg.getLogger("GIF").warning(f"[GIF] file_id={'YES' if file_id else 'NO'} fname={fname}")

    if not file_id:
        sent = await m.reply_text("❌ فقط GIF، mp4 یا عکس قبول می‌کنم")
        schedule_delete(context, sent, 15)
        return

    # ─── ذخیره ───
    try:
        import gifs as gifs_mod
        gid = gifs_mod.add(cid, file_id, fname, user.id)
        _lg.getLogger("GIF").warning(f"[GIF] ✅ saved id={gid} name={fname}")
    except Exception as e:
        _lg.getLogger("GIF").warning(f"[GIF] save err: {e}")
        sent = await m.reply_text(f"❌ خطا: {e}")
        schedule_delete(context, sent, 20)
        return

    sent = await m.reply_text(f"✅ گیف ذخیره شد: {fname[:30]}")
    schedule_delete(context, sent, 20)

    # ─── نشون دادن منو ───
    t, k = settings_menu.gifs_menu(cid)
    menu_msg = await m.reply_text(t, reply_markup=k)
    if chat.type in ("group", "supergroup"):
        schedule_delete(context, menu_msg, 60)


async def cmd_cancel(update, context):
    cid = update.effective_chat.id
    if gif_add_wait.get(cid):
        gif_add_wait[cid] = False
        await update.message.reply_text("❌ لغو شد")
    else:
        await update.message.reply_text("چیزی برای لغو نیست")


def register(app):
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("ping", cmd_ping))
    app.add_handler(CommandHandler("help", cmd_help))
    app.add_handler(CommandHandler("panel", cmd_panel))
    app.add_handler(CommandHandler("me", cmd_pv_panel))
    app.add_handler(CommandHandler("mygroups", cmd_pv_panel))
    app.add_handler(CommandHandler("player", cmd_player))
    app.add_handler(CommandHandler("skin", cmd_skin))
    app.add_handler(CommandHandler("cancel", cmd_cancel))
    app.add_handler(CallbackQueryHandler(cb_handler))
    app.add_handler(MessageHandler(
        filters.ALL & ~filters.TEXT & ~filters.COMMAND,
        gif_upload_handler,
    ))
    app.add_handler(MessageHandler(
        filters.TEXT & (filters.ChatType.GROUP | filters.ChatType.SUPERGROUP) & ~filters.COMMAND,
        file_reply_handler,
    ), group=5)
    app.add_handler(MessageHandler(
        filters.TEXT & (filters.ChatType.GROUP | filters.ChatType.SUPERGROUP | filters.ChatType.PRIVATE) & ~filters.COMMAND,
        msg_handler
    ))

def main():
    log.info("=== Sk.Team Music Bot v3 START ===")
    from telegram.request import HTTPXRequest
    _req = HTTPXRequest(
        connection_pool_size=8,
        read_timeout=60,
        write_timeout=60,
        connect_timeout=30,
        pool_timeout=30,
    )
    app = (Application.builder()
        .token(BOT_TOKEN)
        .request(_req)
        .get_updates_request(_req)
        .post_init(post_init)
        .build())
    register(app)
    log.info("polling...")
    # [MA-REG]
    try:
        import music_admin
        music_admin.register(app)
    except Exception as _ma_err:
        import logging as _lg
        _lg.getLogger('SktTeam').warning('[MA] reg err: ' + str(_ma_err))
    app.run_polling(allowed_updates=Update.ALL_TYPES, drop_pending_updates=True)

if __name__ == "__main__":
    main()
