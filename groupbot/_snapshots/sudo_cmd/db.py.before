    c.execute("INSERT OR REPLACE INTO admin_permissions (chat_id, user_id, role, perm_name, enabled) VALUES (?, ?, ?, ?, ?)",
              (chat_id, user_id, role, perm_name, enabled))
    conn.commit()
    conn.close()


