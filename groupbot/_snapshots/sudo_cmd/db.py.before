        conn = sqlite3.connect(DATABASE_PATH)
        c = conn.cursor()
        c.execute("""SELECT chat_id, reason, banned_by, banned_at, is_global
                     FROM spam_tracker WHERE user_id=?
                     ORDER BY banned_at DESC""", (user_id,))
        rows = c.fetchall()
        conn.close()
        return rows
    except Exception as e:
