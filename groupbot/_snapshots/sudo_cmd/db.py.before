        set_setting(cid, "report_cooldown", str(int(value)))
        return True
    except Exception:
        return False


def fmt_rep_cd(seconds):
    try:
        s = int(seconds)
    except Exception:
        return str(seconds)
    if s < 60:
        return f"{s} ثانیه"
    if s < 3600:
        return f"{s // 60} دقیقه"
    if s < 86400:
        return f"{s // 3600} ساعت"
    return f"{s // 86400} روز"


