        c.execute("INSERT OR REPLACE INTO bot_admins (user_id, first_name, username, added_by, added_at) VALUES (?, ?, ?, ?, ?)", (user_id, first_name or "", username or "", added_by, now))
        conn.commit()
        conn.close()
