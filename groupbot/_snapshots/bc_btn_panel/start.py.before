async def is_privileged_async(user_id, chat, bot):

    try:

        if user_id == OWNER_ID:

            return True

        if is_bot_admin(user_id):

            return True

    except Exception:

        pass

    if chat is not None:

        try:

            m = await bot.get_chat_member(chat.id, user_id)

            if m.status == "creator":

                return True

        except Exception:

            pass

    return False





def is_bot_owner_or_sudo(uid):

    """سازنده ربات یا ادمین ربات (سودو)"""

    try:

        if uid == OWNER_ID:

            return True

        if is_bot_admin(uid):

            return True

    except Exception:

        pass

    return False





def user_is_owner_like(uid, chat_id):

    """سازنده / سودو / مالک گروه"""

    try:

        if uid == OWNER_ID:

            return True

        if is_bot_admin(uid):

            return True

        if is_group_owner(chat_id, uid):

            return True

    except Exception:

        pass

    return False





