def owner_sub_menu(uid, chat_id=0):
    expire = get_expire(chat_id) if chat_id else None
    if expire:
        try:
            exp = datetime.strptime(expire, DATE_FMT)
            if exp > datetime.now():
                remain = exp - datetime.now()
                status = "فعال - " + str(remain.days) + " روز"
            else:
                status = "منقضی شده"
        except Exception:
            status = "نامشخص"
    else:
        status = "فعال نیست"

    return InlineKeyboardMarkup([
        [InlineKeyboardButton("وضعیت: " + status, callback_data="op_sub_status:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("تمدید 30 روزه", callback_data="op_sub_30:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("تمدید 90 روزه", callback_data="op_sub_90:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("تمدید 1 ساله", callback_data="op_sub_365:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("غیرفعال کردن گروه", callback_data="op_sub_off:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("بازگشت", callback_data="op_back:" + str(uid) + ":" + str(chat_id))],
        [InlineKeyboardButton("بستن پنل", callback_data="menu_close:" + str(uid))],
    ])


