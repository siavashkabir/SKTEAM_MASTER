"""ماژول /reset - نسخه مقاوم"""
import datetime
import asyncio
from telegram import Update
from telegram.ext import ContextTypes, CommandHandler, ApplicationHandlerStop


async def send_with_retry(coro_func, retries=3, delay=2):
    """ارسال پیام با تلاش مجدد"""
    last_err = None
    for i in range(retries):
        try:
            return await coro_func()
        except Exception as e:
            last_err = e
            print(f"[RESET SEND ERR] try {i+1}: {e}")
            await asyncio.sleep(delay)
    raise last_err


async def reset_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    msg = update.effective_message
    chat = update.effective_chat
    user = update.effective_user

    if not msg or not chat or not user:
        return
    if chat.type not in ("group", "supergroup"):
        return

    # چک دسترسی
    try:
        from config import OWNER_ID
        from database import is_bot_owner_or_sudo
        if user.id != OWNER_ID and not is_bot_owner_or_sudo(user.id):
            return
    except Exception:
        return

    # لاگ فوری (حتی قبل از ارسال پیام)
    log_time = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[RESET] START Group {chat.id} user {user.id} at {log_time}")

    # پاک کردن کش
    try:
        cleared = len(context.chat_data)
        context.chat_data.clear()
    except Exception as e:
        cleared = 0
        print(f"[RESET CLEAR ERR] {e}")

    print(f"[RESET] Group {chat.id} cleared {cleared} items")

    # ارسال پیام تأیید (بدون Markdown، با retry)
    confirm_text = (
        f"✅ گروه ری‌فرش شد\n\n"
        f"👤 توسط: {user.first_name}\n"
        f"🧹 کش پاک شد: {cleared} آیتم\n"
        f"🕒 زمان: {log_time}"
    )

    try:
        await send_with_retry(
            lambda: msg.reply_text(confirm_text),
            retries=3,
            delay=2
        )
        print(f"[RESET] confirmation sent for group {chat.id}")
    except Exception as e:
        print(f"[RESET FINAL ERR] could not send confirmation: {e}")

    raise ApplicationHandlerStop


def register(app):
    app.add_handler(
        CommandHandler(["reset", "ريست", "ریست"], reset_cmd),
        group=-2
    )
    print("OK module reset_cmd loaded")
